{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://intent-cli.dev/schemas/beads-regenerate-response.json",
  "title": "Intent CLI Beads Regenerate Response",
  "description": "JSON response schema for 'intent beads-regenerate' command",
  "allOf": [
    { "$ref": "base-response.json" },
    {
      "properties": {
        "action": { "const": "beads_regenerate_result" },
        "command": { "const": "beads-regenerate" },
        "data": { "$ref": "#/definitions/BeadsRegenerateData" }
      }
    }
  ],
  "definitions": {
    "BeadsRegenerateData": {
      "type": "object",
      "properties": {
        "spec_path": { "type": "string" },
        "beads": {
          "type": "array",
          "items": { "$ref": "#/definitions/BeadRecord" }
        },
        "total": { "type": "integer" },
        "regenerated": { "type": "integer" },
        "source": { "type": "string", "enum": ["spec", "quality", "gaps"] }
      },
      "required": ["spec_path", "beads", "total", "regenerated", "source"]
    },
    "BeadRecord": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "profile_type": { "type": "string" },
        "priority": { "type": "integer" },
        "issue_type": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "ai_hints": { "type": "string" },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "description", "profile_type", "priority", "issue_type", "labels", "ai_hints", "acceptance_criteria", "dependencies"]
    }
  }
}
