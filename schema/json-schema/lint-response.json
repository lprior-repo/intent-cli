{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://intent-cli.dev/schemas/lint-response.json",
  "title": "Intent CLI Lint Response",
  "description": "JSON response schema for 'intent lint' command",
  "allOf": [
    {
      "$ref": "base-response.json"
    },
    {
      "properties": {
        "action": {
          "const": "lint_result"
        },
        "command": {
          "const": "lint"
        },
        "data": {
          "$ref": "#/definitions/LintData"
        }
      }
    }
  ],
  "definitions": {
    "LintData": {
      "type": "object",
      "required": ["status", "warnings"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["valid", "warnings"],
          "description": "Lint result status"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/LintWarning"
          },
          "description": "List of lint warnings"
        }
      }
    },
    "LintWarning": {
      "type": "object",
      "required": ["severity", "category", "message", "location"],
      "properties": {
        "severity": {
          "type": "string",
          "description": "Warning severity level"
        },
        "category": {
          "type": "string",
          "description": "Warning category"
        },
        "message": {
          "type": "string",
          "description": "Warning message"
        },
        "location": {
          "type": "object",
          "properties": {
            "behavior": {
              "type": ["string", "null"]
            },
            "field": {
              "type": ["string", "null"]
            },
            "anti_pattern": {
              "type": ["string", "null"]
            },
            "behavior1": {
              "type": ["string", "null"]
            },
            "behavior2": {
              "type": ["string", "null"]
            }
          }
        }
      }
    }
  }
}
