import gleeunit/should
import gleam/json
import gleam/option.{None}
import intent/ai_schema
import intent/json_output
import gleam/list

/// Test that schema command returns proper JSON structure for specific schema
pub fn schema_command_specific_test() {
  // Simulate: intent ai schema --command=quality --type=input
  let result = ai_schema.get_schema(command: "quality", schema_type: "input")

  case result {
    Ok(content) -> {
      // Should return non-empty CUE schema
      content
      |> should.not_equal("")

      // Create expected JSON response structure
      let data =
        json.object([
          #("command", json.string("quality")),
          #("schema_type", json.string("input")),
          #("content", json.string(content)),
        ])

      let response =
        json_output.success(
          "schema_result",
          "ai schema",
          data,
          None,
          [],
        )

      // Verify response structure
      response.success
      |> should.equal(True)

      response.action
      |> should.equal("schema_result")

      response.command
      |> should.equal("ai schema")
    }
    Error(_) -> should.fail()
  }
}

/// Test that schema command returns proper JSON for --all flag
pub fn schema_command_all_test() {
  // Simulate: intent ai schema --all
  let result = ai_schema.get_all_schemas()

  case result {
    Ok(schemas) -> {
      schemas
      |> should.not_equal([])

      // Create expected JSON response with array of schemas
      let schemas_json =
        json.array(schemas, fn(schema) {
          json.object([
            #("command", json.string(schema.command)),
            #("schema_type", json.string(schema.schema_type)),
            #("content", json.string(schema.content)),
          ])
        })

      let data =
        json.object([
          #("schemas", schemas_json),
          #("count", json.int(schemas |> list.length)),
        ])

      let response =
        json_output.success(
          "schema_list_result",
          "ai schema",
          data,
          None,
          [],
        )

      // Verify response structure
      response.success
      |> should.equal(True)

      response.action
      |> should.equal("schema_list_result")
    }
    Error(_) -> should.fail()
  }
}

/// Test error handling for missing schema
pub fn schema_command_missing_test() {
  // Simulate: intent ai schema --command=nonexistent --type=input
  let result = ai_schema.get_schema(command: "nonexistent", schema_type: "input")

  case result {
    Error(ai_schema.SchemaNotFound(cmd)) -> {
      // Create expected error response
      let error =
        json_output.detailed_error(
          "schema_not_found",
          "Schema not found for command: " <> cmd,
          "schema/ai/input/" <> cmd <> ".cue",
          "Check available schemas with: intent ai schema --all",
          "intent ai schema --all",
        )

      let data = json.object([#("command", json.string(cmd))])

      let response =
        json_output.failure(
          "schema_error",
          "ai schema",
          data,
          [error],
          None,
          [],
          1,
        )

      // Verify error response
      response.success
      |> should.equal(False)

      response.errors
      |> list.length
      |> should.equal(1)
    }
    _ -> should.fail()
  }
}

/// Test error handling for invalid schema type
pub fn schema_command_invalid_type_test() {
  // Simulate: intent ai schema --command=quality --type=invalid
  let result = ai_schema.get_schema(command: "quality", schema_type: "invalid")

  case result {
    Error(ai_schema.InvalidSchemaType(typ)) -> {
      // Create expected error response
      let error =
        json_output.detailed_error(
          code: "invalid_schema_type",
          message: "Invalid schema type: " <> typ <> ". Must be 'input' or 'output'",
          location: "command line",
          fix_hint: "Use --type=input or --type=output",
          fix_command: "intent ai schema --command=quality --type=input",
        )

      let data = json.object([#("schema_type", json.string(typ))])

      let response =
        json_output.failure(
          action: "schema_error",
          command: "ai schema",
          data: data,
          errors: [error],
          spec_path: None,
          next_actions: [],
          exit_code: 1,
        )

      // Verify error response
      response.success
      |> should.equal(False)

      response.errors
      |> list.length
      |> should.equal(1)
    }
    _ -> should.fail()
  }
}

/// Test list commands functionality
pub fn schema_command_list_commands_test() {
  // Simulate: intent ai schema --list
  let result = ai_schema.list_commands()

  case result {
    Ok(commands) -> {
      commands
      |> should.not_equal([])

      // Create expected JSON response
      let data =
        json.object([
          #("commands", json.array(commands, json.string)),
          #("count", json.int(commands |> list.length)),
        ])

      let response =
        json_output.success(
          action: "schema_commands_result",
          command: "ai schema",
          data: data,
          spec_path: None,
          next_actions: [],
        )

      // Verify response structure
      response.success
      |> should.equal(True)
    }
    Error(_) -> should.fail()
  }
}

// Required imports
import gleam/list
import gleam/string
