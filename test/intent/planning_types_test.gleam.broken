import gleam/option.{None, Some}
import gleeunit/should
import intent/planning_types.{
  type Blocker, type DimensionScore, type FeatureShape, type MVPSlice,
  type ReadyReport, type Recommendation, type Scenario, type ShapeSection,
  type VisionSection, Blocker, BlockerSeverity, Critical, DimensionScore,
  FeatureShape, High, Low, MVPSlice, Medium, ReadyReport, Recommendation,
  Scenario, ShapeSection, VisionSection,
}

pub fn vision_section_construction_test() {
  let scenario =
    Scenario(
      character: "API Developer",
      persona: "Backend engineer building REST APIs",
      motivation: "Want to ensure API contracts are correct",
      simulation: "Developer writes CUE spec, runs validation",
      outcome: "API meets all contract requirements",
    )

  let vision =
    VisionSection(
      press_release: "Intent CLI transforms API testing with contract-first approach",
      persona: "Backend developers building REST APIs",
      non_personas: ["Frontend developers", "DevOps engineers"],
      north_star: "Every API ships with verified contracts",
      scenarios: [scenario],
      replaces: Some("Manual API testing with Postman"),
      vorp: "10x faster contract verification with zero ambiguity",
      out_of_scope: ["Load testing", "UI testing"],
    )

  vision.persona |> should.equal("Backend developers building REST APIs")
  vision.scenarios |> should.not_equal([])
  vision.replaces |> should.equal(Some("Manual API testing with Postman"))
}

pub fn shape_section_construction_test() {
  let feature = FeatureShape(name: "Contract Validation", description: "Validate API responses against CUE specs")

  let mvp_slice =
    MVPSlice(
      description: "Minimal viable contract testing",
      features: ["Contract Validation", "Error Reporting"],
      shortcuts: ["Skip load testing", "Hardcode test data"],
    )

  let shape =
    ShapeSection(
      features: [feature],
      critical_path: ["Contract Validation"],
      mvp_slice: mvp_slice,
      post_mvp: ["Performance testing", "CI/CD integration"],
      validation_moment: "First successful contract verification",
    )

  shape.features |> should.not_equal([])
  shape.validation_moment
  |> should.equal("First successful contract verification")
}

pub fn ready_report_construction_test() {
  let dimension =
    DimensionScore(
      score: 85,
      reasoning: "Strong value proposition",
      issues: ["Need more user validation"],
    )

  let blocker =
    Blocker(
      severity: Critical,
      description: "Missing authentication support",
      affected_areas: ["Security", "User Management"],
    )

  let recommendation =
    Recommendation(
      priority: 1,
      description: "Add OAuth2 support",
      rationale: "Required for enterprise adoption",
    )

  let report =
    ReadyReport(
      replacement: dimension,
      empathy: dimension,
      actionable: dimension,
      discoverable: dimension,
      yet_complete: dimension,
      overall_readiness: 82,
      blockers: [blocker],
      recommendations: [recommendation],
    )

  report.overall_readiness |> should.equal(82)
  report.blockers |> should.not_equal([])
}

pub fn blocker_severity_test() {
  let critical = Critical
  let high = High
  let medium = Medium
  let low = Low

  critical |> should.not_equal(high)
  medium |> should.not_equal(low)
}

pub fn scenario_construction_test() {
  let scenario =
    Scenario(
      character: "QA Engineer",
      persona: "Quality assurance professional",
      motivation: "Automate contract testing",
      simulation: "Run contract tests in CI pipeline",
      outcome: "All contracts verified automatically",
    )

  scenario.character |> should.equal("QA Engineer")
  scenario.outcome |> should.equal("All contracts verified automatically")
}

pub fn feature_shape_construction_test() {
  let feature =
    FeatureShape(
      name: "KIRK Analysis",
      description: "5-round mental model analysis system",
    )

  feature.name |> should.equal("KIRK Analysis")
}

pub fn mvp_slice_construction_test() {
  let mvp =
    MVPSlice(
      description: "Bare minimum to validate concept",
      features: ["Core feature A", "Core feature B"],
      shortcuts: ["Skip polish", "Manual configuration"],
    )

  mvp.features |> should.not_equal([])
  mvp.shortcuts |> should.not_equal([])
}

pub fn dimension_score_construction_test() {
  let score =
    DimensionScore(
      score: 75,
      reasoning: "Good but needs improvement",
      issues: ["Issue 1", "Issue 2"],
    )

  score.score |> should.equal(75)
  score.issues |> should.not_equal([])
}
