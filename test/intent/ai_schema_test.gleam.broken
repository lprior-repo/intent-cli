import gleeunit/should
import intent/ai_schema

pub fn get_schema_for_command_input_test() {
  // Test getting input schema for a specific command
  let result = ai_schema.get_schema(command: "quality", schema_type: "input")

  case result {
    Ok(content) -> {
      content
      |> should.not_equal("")
    }
    Error(_) -> should.fail()
  }
}

pub fn get_schema_for_command_output_test() {
  // Test getting output schema for a specific command
  let result = ai_schema.get_schema(command: "quality", schema_type: "output")

  case result {
    Ok(content) -> {
      content
      |> should.not_equal("")
    }
    Error(_) -> should.fail()
  }
}

pub fn get_all_schemas_test() {
  // Test getting all schemas
  let result = ai_schema.get_all_schemas()

  case result {
    Ok(schemas) -> {
      schemas
      |> should.not_equal([])
    }
    Error(_) -> should.fail()
  }
}

pub fn get_schema_missing_directory_test() {
  // Test graceful handling when schema directory doesn't exist
  // This should fail gracefully with a proper error
  let result =
    ai_schema.get_schema(command: "nonexistent", schema_type: "input")

  case result {
    Error(ai_schema.SchemaDirectoryNotFound) -> should.equal(True, True)
    Error(ai_schema.SchemaNotFound(_)) -> should.equal(True, True)
    Ok(_) -> should.fail()
    _ -> should.fail()
  }
}

pub fn get_schema_invalid_type_test() {
  // Test error handling for invalid schema type
  let result = ai_schema.get_schema(command: "quality", schema_type: "invalid")

  case result {
    Error(ai_schema.InvalidSchemaType(_)) -> should.equal(True, True)
    _ -> should.fail()
  }
}

pub fn list_available_commands_test() {
  // Test listing all commands that have schemas
  let result = ai_schema.list_commands()

  case result {
    Ok(commands) -> {
      commands
      |> should.not_equal([])
    }
    Error(_) -> should.fail()
  }
}
