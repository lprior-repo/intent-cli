//// Comprehensive tests for intent/validator.gleam
//// Tests validation of specs, behaviors, dependencies, variables, and circular dependencies

import gleam/dict
import gleam/json
import gleam/list
import gleeunit/should
import intent/types.{
  type Behavior, type Check, type Config, type Feature, type Method, type Request, type Response, type Spec,
  Behavior, Check, Config, Feature, Get, Post, Request, Response, Spec,
}
import intent/validator.{
  type ValidationIssue, type ValidationResult,
  CircularDependency, MissingCapture, MissingDependency,
  format_issues, validate_spec,
}

// ============================================================================
// Helper Functions for Building Test Data
// ============================================================================

fn empty_dict() -> dict.Dict(String, String) {
  dict.new()
}

fn empty_json_dict() -> dict.Dict(String, json.Json) {
  dict.new()
}

fn empty_check_dict() -> dict.Dict(String, Check) {
  dict.new()
}

fn simple_config() -> Config {
  Config(
    base_url: "http://localhost:8080",
    timeout_ms: 5000,
    headers: empty_dict(),
  )
}

fn simple_request(path: String) -> Request {
  Request(
    method: Get,
    path: path,
    headers: empty_dict(),
    query: empty_json_dict(),
    body: json.null(),
  )
}

fn simple_response() -> Response {
  Response(
    status: 200,
    example: json.null(),
    checks: empty_check_dict(),
    headers: empty_dict(),
  )
}

fn simple_behavior(name: String) -> Behavior {
  Behavior(
    name: name,
    intent: "Test behavior",
    notes: "",
    requires: [],
    tags: [],
    request: simple_request("/test"),
    response: simple_response(),
    captures: empty_dict(),
  )
}

fn simple_feature(name: String, behaviors: List(Behavior)) -> Feature {
  Feature(name: name, description: "Test feature", behaviors: behaviors)
}

fn simple_spec(features: List(Feature)) -> Spec {
  Spec(
    name: "test_spec",
    description: "Test specification",
    audience: "developers",
    version: "1.0.0",
    success_criteria: [],
    config: simple_config(),
    features: features,
    rules: [],
    anti_patterns: [],
    ai_hints: intent
      / types.AIHints(
      implementation: intent / types.ImplementationHints(suggested_stack: []),
      entities: empty_dict(),
      security: intent
        / types.SecurityHints(
        password_hashing: "bcrypt",
        jwt_algorithm: "HS256",
        jwt_expiry: "24h",
        rate_limiting: "1000/hour",
      ),
      pitfalls: [],
    ),
  )
}

// ============================================================================
// ValidationResult Tests
// ============================================================================

pub fn validate_spec_with_no_issues_returns_valid_test() {
  let behavior = simple_behavior("get_user")
  let feature = simple_feature("users", [behavior])
  let spec = simple_spec([feature])

  validate_spec(spec)
  |> should.equal(ValidationValid)
}

pub fn validate_spec_with_multiple_behaviors_returns_valid_test() {
  let behavior1 = simple_behavior("get_user")
  let behavior2 = simple_behavior("list_users")
  let feature = simple_feature("users", [behavior1, behavior2])
  let spec = simple_spec([feature])

  validate_spec(spec)
  |> should.equal(ValidationValid)
}

pub fn validate_spec_with_multiple_features_returns_valid_test() {
  let user_behavior = simple_behavior("get_user")
  let user_feature = simple_feature("users", [user_behavior])

  let post_behavior = simple_behavior("create_post")
  let post_feature = simple_feature("posts", [post_behavior])

  let spec = simple_spec([user_feature, post_feature])

  validate_spec(spec)
  |> should.equal(ValidationValid)
}

// ============================================================================
// Missing Dependency Tests
// ============================================================================

pub fn validate_spec_detects_missing_dependency_test() {
  let behavior =
    Behavior(
      name: "get_user_posts",
      intent: "Get user posts",
      notes: "",
      requires: ["nonexistent_behavior"],
      tags: [],
      request: simple_request("/user/1/posts"),
      response: simple_response(),
      captures: empty_dict(),
    )

  let feature = simple_feature("posts", [behavior])
  let spec = simple_spec([feature])

  let result = validate_spec(spec)
  case result {
    ValidationInvalid(issues) -> {
      issues
      |> list.any(fn(issue) {
        case issue {
          MissingDependency("get_user_posts", "nonexistent_behavior") -> True
          _ -> False
        }
      })
      |> should.be_true()
    }
    _ -> should.fail("Expected ValidationInvalid")
  }
}

pub fn validate_spec_allows_valid_dependency_test() {
  let get_user = simple_behavior("get_user")
  let get_posts =
    Behavior(
      name: "get_user_posts",
      intent: "Get user posts",
      notes: "",
      requires: ["get_user"],
      tags: [],
      request: simple_request("/user/1/posts"),
      response: simple_response(),
      captures: empty_dict(),
    )

  let feature = simple_feature("users", [get_user, get_posts])
  let spec = simple_spec([feature])

  validate_spec(spec)
  |> should.equal(ValidationValid)
}

pub fn validate_spec_detects_multiple_missing_dependencies_test() {
  let behavior =
    Behavior(
      name: "complex_behavior",
      intent: "Complex behavior",
      notes: "",
      requires: ["missing1", "missing2"],
      tags: [],
      request: simple_request("/test"),
      response: simple_response(),
      captures: empty_dict(),
    )

  let feature = simple_feature("test", [behavior])
  let spec = simple_spec([feature])

  let result = validate_spec(spec)
  case result {
    ValidationInvalid(issues) -> {
      let missing_dep_issues =
        issues
        |> list.filter(fn(issue) {
          case issue {
            MissingDependency(_, _) -> True
            _ -> False
          }
        })

      missing_dep_issues
      |> list.length
      |> should.equal(2)
    }
    _ -> should.fail("Expected ValidationInvalid")
  }
}

// ============================================================================
// Circular Dependency Tests
// ============================================================================

pub fn validate_spec_detects_direct_self_dependency_test() {
  let behavior =
    Behavior(
      name: "self_loop",
      intent: "Self loop",
      notes: "",
      requires: ["self_loop"],
      tags: [],
      request: simple_request("/test"),
      response: simple_response(),
      captures: empty_dict(),
    )

  let feature = simple_feature("test", [behavior])
  let spec = simple_spec([feature])

  let result = validate_spec(spec)
  case result {
    ValidationInvalid(issues) -> {
      issues
      |> list.any(fn(issue) {
        case issue {
          CircularDependency(_) -> True
          _ -> False
        }
      })
      |> should.be_true()
    }
    _ -> should.fail("Expected ValidationInvalid with circular dependency")
  }
}

