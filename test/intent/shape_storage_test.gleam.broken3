import gleeunit/should
import intent/planning_types.{FeatureShape, MVPSlice, ShapeSection}
import intent/shape_storage

pub fn shape_section_to_json_test() {
  let section =
    ShapeSection(
      features: [FeatureShape("User API", "REST API for users")],
      critical_path: ["Authentication", "CRUD operations"],
      mvp_slice: MVPSlice(
        description: "Basic user management",
        features: ["Login", "List users"],
        shortcuts: ["Hardcode admin credentials"],
      ),
      post_mvp: ["Advanced search", "Analytics"],
      validation_moment: "User can log in and see their profile",
    )

  let json = shape_storage.shape_section_to_json(section)
  let json_string = shape_storage.json_to_string(json)

  json_string |> should.contain("User API")
  json_string |> should.contain("Authentication")
  json_string |> should.contain("Basic user management")
}

pub fn parse_shape_documents_content_empty_test() {
  let documents = shape_storage.parse_shape_documents_content("")
  documents |> should.equal([])
}

pub fn update_documents_content_test() {
  let doc1 =
    shape_storage.ShapeDocument(
      id: "doc-1",
      title: "First Shape",
      created_at: "2026-01-25T10:00:00Z",
      updated_at: "2026-01-25T10:00:00Z",
      sections: [],
    )

  let content1 = shape_storage.update_documents_content("", doc1)
  content1 |> should.not_equal("")

  // Update same document
  let doc1_updated =
    shape_storage.ShapeDocument(..doc1, updated_at: "2026-01-25T11:00:00Z")

  let content2 = shape_storage.update_documents_content(content1, doc1_updated)

  // Should only have one line (updated version)
  let lines = content2 |> string_split("\n") |> list_filter(fn(l) { l != "" })
  lines |> should.have_length(1)
}

pub fn find_document_by_id_test() {
  let doc1 =
    shape_storage.ShapeDocument(
      id: "doc-1",
      title: "First",
      created_at: "2026-01-25T10:00:00Z",
      updated_at: "2026-01-25T10:00:00Z",
      sections: [],
    )

  let doc2 =
    shape_storage.ShapeDocument(
      id: "doc-2",
      title: "Second",
      created_at: "2026-01-25T10:00:00Z",
      updated_at: "2026-01-25T10:00:00Z",
      sections: [],
    )

  let documents = [doc1, doc2]

  let found = shape_storage.find_document_by_id(documents, "doc-2")
  found |> should.be_ok()

  let not_found = shape_storage.find_document_by_id(documents, "doc-3")
  not_found |> should.be_error()
}

// Helper functions
fn string_split(string: String, separator: String) -> List(String) {
  case string {
    "" -> []
    _ -> do_split(string, separator, [])
  }
}

fn do_split(
  string: String,
  separator: String,
  acc: List(String),
) -> List(String) {
  case string_contains(string, separator) {
    True -> {
      let parts = string_split_once(string, separator)
      do_split(parts.1, separator, [parts.0, ..acc])
    }
    False -> list_reverse([string, ..acc])
  }
}

@external(erlang, "string", "find")
fn string_contains(string: String, substring: String) -> Bool

@external(erlang, "string", "split")
fn string_split_once(string: String, separator: String) -> #(String, String)

fn list_reverse(list: List(a)) -> List(a) {
  do_reverse(list, [])
}

fn do_reverse(list: List(a), acc: List(a)) -> List(a) {
  case list {
    [] -> acc
    [head, ..rest] -> do_reverse(rest, [head, ..acc])
  }
}

fn list_filter(list: List(a), predicate: fn(a) -> Bool) -> List(a) {
  case list {
    [] -> []
    [head, ..rest] ->
      case predicate(head) {
        True -> [head, ..list_filter(rest, predicate)]
        False -> list_filter(rest, predicate)
      }
  }
}
