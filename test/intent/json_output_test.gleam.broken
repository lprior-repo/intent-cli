import gleam/json
import gleam/option.{None, Some}
import gleam/string
import gleeunit/should
import intent/json_output

// ============================================================================
// Core JSON Schema Tests
// ============================================================================

pub fn success_response_has_all_required_fields_test() {
  let response =
    json_output.success("test_action", "test_command", json.null(), None, [])

  let json_string = response |> json_output.to_json |> json.to_string

  // Verify all required top-level fields exist
  string.contains(json_string, "\"success\"")
  |> should.be_true

  string.contains(json_string, "\"action\"")
  |> should.be_true

  string.contains(json_string, "\"command\"")
  |> should.be_true

  string.contains(json_string, "\"data\"")
  |> should.be_true

  string.contains(json_string, "\"errors\"")
  |> should.be_true

  string.contains(json_string, "\"next_actions\"")
  |> should.be_true

  string.contains(json_string, "\"metadata\"")
  |> should.be_true

  string.contains(json_string, "\"spec_path\"")
  |> should.be_true
}

pub fn failure_response_has_all_required_fields_test() {
  let response =
    json_output.failure(
      "test_failed",
      "test_command",
      json.null(),
      [],
      Some("/path/to/spec.cue"),
      [],
      1,
    )

  let json_string = response |> json_output.to_json |> json.to_string

  // Verify all required fields exist
  string.contains(json_string, "\"success\":false")
  |> should.be_true

  string.contains(json_string, "\"action\":\"test_failed\"")
  |> should.be_true

  string.contains(json_string, "\"command\":\"test_command\"")
  |> should.be_true
}

