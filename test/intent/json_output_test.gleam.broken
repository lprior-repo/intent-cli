pub fn metadata_includes_exit_code_test() {
  let response =
    json_output.failure("test_failed", "test", json.null(), [], None, [], 42)

  let json_string = response |> json_output.to_json |> json.to_string

  // Verify exit_code exists and has correct value
  string.contains(json_string, "\"exit_code\":42")
  |> should.be_true
}

// ============================================================================
// Next Actions Tests
// ============================================================================

pub fn next_actions_empty_array_when_none_provided_test() {
  let response =
    json_output.success("test_action", "test", json.null(), None, [])

  let json_string = response |> json_output.to_json |> json.to_string

  // Verify next_actions is an empty array
  string.contains(json_string, "\"next_actions\":[]")
  |> should.be_true
}

pub fn next_actions_contains_command_and_reason_test() {
  let next_actions = [
    json_output.next_action("intent gaps spec.cue", "Find coverage gaps"),
  ]

  let response =
    json_output.success("test_action", "test", json.null(), None, next_actions)

  let json_string = response |> json_output.to_json |> json.to_string

  // Verify next_actions contains the command and reason
  string.contains(json_string, "\"command\":\"intent gaps spec.cue\"")
  |> should.be_true

  string.contains(json_string, "\"reason\":\"Find coverage gaps\"")
  |> should.be_true
}

pub fn next_actions_supports_multiple_suggestions_test() {
  let next_actions = [
    json_output.next_action("intent gaps spec.cue", "Find gaps"),
    json_output.next_action("intent invert spec.cue", "Analyze failures"),
    json_output.next_action("intent doctor spec.cue", "Get recommendations"),
  ]

  let response =
    json_output.success("test_action", "test", json.null(), None, next_actions)

  let json_string = response |> json_output.to_json |> json.to_string

  // Verify all three next_actions are present
  string.contains(json_string, "\"command\":\"intent gaps spec.cue\"")
  |> should.be_true

  string.contains(json_string, "\"command\":\"intent invert spec.cue\"")
  |> should.be_true

  string.contains(json_string, "\"command\":\"intent doctor spec.cue\"")
  |> should.be_true
}

pub fn with_next_actions_adds_suggestions_to_response_test() {
  let response =
    json_output.success("test_action", "test", json.null(), None, [])

  let next_actions = [
    json_output.next_action("intent quality spec.cue", "Check quality"),
  ]

  let updated = json_output.with_next_actions(response, next_actions)

  let json_string = updated |> json_output.to_json |> json.to_string

  // Verify next_actions were added
  string.contains(json_string, "\"command\":\"intent quality spec.cue\"")
  |> should.be_true
}

// ============================================================================
// Error Handling Tests
// ============================================================================

pub fn errors_empty_array_for_success_test() {
  let response =
    json_output.success("test_action", "test", json.null(), None, [])

  let json_string = response |> json_output.to_json |> json.to_string

  // Verify errors is an empty array for success
  string.contains(json_string, "\"errors\":[]")
  |> should.be_true
}

pub fn errors_contains_code_and_message_test() {
  let errors = [json_output.error("validation_error", "Spec is invalid")]

  let response =
    json_output.failure("test_failed", "test", json.null(), errors, None, [], 1)

  let json_string = response |> json_output.to_json |> json.to_string

  // Verify error code and message are present
  string.contains(json_string, "\"code\":\"validation_error\"")
  |> should.be_true

  string.contains(json_string, "\"message\":\"Spec is invalid\"")
  |> should.be_true
}

pub fn detailed_error_includes_all_fields_test() {
  let errors = [
    json_output.detailed_error(
      "parse_error",
      "Failed to parse CUE",
      "line 42",
      "Check syntax",
      "intent validate spec.cue",
    ),
  ]

  let response =
    json_output.failure("test_failed", "test", json.null(), errors, None, [], 1)

  let json_string = response |> json_output.to_json |> json.to_string

  // Verify all error fields are present
  string.contains(json_string, "\"code\":\"parse_error\"")
  |> should.be_true

  string.contains(json_string, "\"location\":\"line 42\"")
  |> should.be_true

  string.contains(json_string, "\"fix_hint\":\"Check syntax\"")
  |> should.be_true

  string.contains(json_string, "\"fix_command\":\"intent validate spec.cue\"")
  |> should.be_true
}

// ============================================================================
// Spec Path Tests
// ============================================================================

pub fn spec_path_null_when_none_test() {
  let response =
    json_output.success("test_action", "test", json.null(), None, [])

  let json_string = response |> json_output.to_json |> json.to_string

  // Verify spec_path is null
  string.contains(json_string, "\"spec_path\":null")
  |> should.be_true
}

pub fn spec_path_string_when_provided_test() {
  let response =
    json_output.success(
      "test_action",
      "test",
      json.null(),
      Some("/path/to/spec.cue"),
      [],
    )

  let json_string = response |> json_output.to_json |> json.to_string

  // Verify spec_path contains the path
  string.contains(json_string, "\"spec_path\":\"/path/to/spec.cue\"")
  |> should.be_true
}
