//// Tests for intent/kirk/ready.gleam
//// Contract: READY Framework analysis across 5 dimensions
//// - Replacement: Is the VORP (Value Over Replacement Product) still valid?
//// - Empathy: Is user friction simulated?
//// - Actionable: Do errors guide users?
//// - Discoverable: Are features findable?
//// - Yet-complete: Can the north star be achieved?

import gleam/dict
import gleam/float
import gleam/int
import gleam/json
import gleam/list
import gleam/string
import gleeunit
import gleeunit/should
import intent/kirk/ready
import intent/planning_types.{
  type BlockerSeverity, Critical, DimensionScore, High, Medium,
}
import intent/types.{
  type Spec, AIHints, AntiPattern, Behavior, Check, Config, Feature, Get,
  ImplementationHints, Request, Response, Rule, SecurityHints, Spec,
}
import test_helpers

pub fn main() {
  gleeunit.main()
}

// =============================================================================
// TEST HELPERS
// =============================================================================

/// Create a minimal spec for testing
fn minimal_spec() -> Spec {
  Spec(
    name: "Minimal Spec",
    description: "A very short description",
    audience: "",
    version: "1",
    success_criteria: [],
    config: Config(
      base_url: "",
      timeout_ms: 5000,
      headers: dict.new(),
      allow_localhost: False,
    ),
    features: [],
    rules: [],
    anti_patterns: [],
    ai_hints: AIHints(
      implementation: ImplementationHints(suggested_stack: []),
      entities: dict.new(),
      security: SecurityHints(
        password_hashing: "",
        jwt_algorithm: "",
        jwt_expiry: "",
        rate_limiting: "",
      ),
      pitfalls: [],
    ),
  )
}

/// Create a complete, high-quality spec for testing
fn complete_spec() -> Spec {
  let behavior_with_checks =
    Behavior(
      name: "get-user",
      intent: "Retrieve a user by their unique identifier from the database",
      notes: "This validates that the user exists",
      requires: [],
      tags: ["users", "read"],
      request: Request(
        method: Get,
        path: "/users/${id}",
        headers: dict.new(),
        query: dict.new(),
        body: json.null(),
      ),
      response: Response(
        status: 200,
        example: json.object([
          #("id", json.int(1)),
          #("name", json.string("Test")),
        ]),
        checks: dict.from_list([
          #(
            "id",
            Check(
              rule: "integer",
              why: "ID must be numeric for database lookup",
            ),
          ),
          #("name", Check(rule: "string", why: "Name must be a valid string")),
        ]),
        headers: dict.new(),
      ),
      captures: dict.new(),
    )

  let error_behavior =
    Behavior(
      name: "user-not-found",
      intent: "Return 404 when user does not exist in the database",
      notes: "Validation test for missing resource",
      requires: [],
      tags: ["users", "error"],
      request: Request(
        method: Get,
        path: "/users/999999",
        headers: dict.new(),
        query: dict.new(),
        body: json.null(),
      ),
      response: Response(
        status: 404,
        example: json.object([#("error", json.string("User not found"))]),
        checks: dict.from_list([
          #("error", Check(rule: "string", why: "Error message must be clear")),
        ]),
        headers: dict.new(),
      ),
      captures: dict.new(),
    )

  let unauthorized_behavior =
    Behavior(
      name: "unauthorized-access",
      intent: "Verify that unauthorized access is properly rejected",
      notes: "Security validation check",
      requires: [],
      tags: ["security", "auth"],
      request: Request(
        method: Get,
        path: "/admin/users",
        headers: dict.new(),
        query: dict.new(),
        body: json.null(),
      ),
      response: Response(
        status: 401,
        example: json.object([#("error", json.string("Unauthorized"))]),
        checks: dict.new(),
        headers: dict.new(),
      ),
      captures: dict.new(),
    )

  let feature1 =
    Feature(
      name: "User Management",
      description: "Manage user accounts",
      behaviors: [behavior_with_checks, error_behavior],
    )

  let feature2 =
    Feature(
      name: "Security",
      description: "Authentication and authorization",
      behaviors: [unauthorized_behavior],
    )

  Spec(
    name: "Complete User API",
    description: "A comprehensive user management API with authentication, CRUD operations, and error handling",
    audience: "Frontend developers building user interfaces for web and mobile applications",
    version: "2.1.0",
    success_criteria: [
      "All user CRUD operations work correctly",
      "Authentication prevents unauthorized access",
      "Error messages guide users to resolution",
      "API follows REST conventions",
    ],
    config: Config(
      base_url: "https://api.example.com",
      timeout_ms: 5000,
      headers: dict.new(),
      allow_localhost: False,
    ),
    features: [feature1, feature2],
    rules: [
      Rule(
        name: "auth-required",
        condition: "path.startswith('/admin')",
        constraint: "headers.authorization != null",
        why: "Admin endpoints require authentication",
      ),
    ],
    anti_patterns: [
      AntiPattern(
        pattern: "exposing-internal-ids",
        description: "Never expose internal database IDs to clients",
        why: "Security risk and tight coupling",
      ),
      AntiPattern(
        pattern: "generic-errors",
        description: "Avoid generic error messages like 'Something went wrong'",
        why: "Users cannot diagnose or fix the issue",
      ),
    ],
    ai_hints: AIHints(
      implementation: ImplementationHints(suggested_stack: [
        "Express.js",
        "PostgreSQL",
        "JWT",
      ]),
      entities: dict.from_list([
        #("User", "id, email, name, created_at"),
      ]),
      security: SecurityHints(
        password_hashing: "bcrypt with cost factor 12",
        jwt_algorithm: "RS256",
        jwt_expiry: "15 minutes",
        rate_limiting: "100 requests per minute per IP",
      ),
      pitfalls: ["SQL injection in user queries", "Missing rate limiting"],
    ),
  )
}

// =============================================================================
// ANALYZE_READY - Core Functionality
// =============================================================================

pub fn analyze_ready_empty_spec_test() {
  // Contract: Empty spec produces valid ReadyReport with scores in range [0, 100]
  let spec = test_helpers.make_test_spec_from_behaviors([])

  let report = ready.analyze_ready(spec)

  // All dimension scores should be in valid range
  { report.replacement.score >= 0 && report.replacement.score <= 100 }
  |> should.be_true
  { report.empathy.score >= 0 && report.empathy.score <= 100 }
  |> should.be_true
  { report.actionable.score >= 0 && report.actionable.score <= 100 }
  |> should.be_true
  { report.discoverable.score >= 0 && report.discoverable.score <= 100 }
  |> should.be_true
  { report.yet_complete.score >= 0 && report.yet_complete.score <= 100 }
  |> should.be_true
  { report.overall_readiness >= 0 && report.overall_readiness <= 100 }
  |> should.be_true
}

pub fn analyze_ready_minimal_spec_test() {
  // Contract: Minimal spec with basic fields produces low but valid scores
  let spec = minimal_spec()

  let report = ready.analyze_ready(spec)

  // Should have low scores due to minimal content
  { report.overall_readiness < 50 } |> should.be_true
  // Should generate blockers for low quality
  { list.length(report.blockers) > 0 } |> should.be_true
  // Should generate recommendations
  { list.length(report.recommendations) > 0 } |> should.be_true
}

pub fn analyze_ready_complete_spec_test() {
  // Contract: Well-formed spec with all fields produces high scores
  let spec = complete_spec()

  let report = ready.analyze_ready(spec)

  // Overall readiness should be relatively high
  { report.overall_readiness >= 70 } |> should.be_true
  // Each dimension should have reasoning
  { string.length(report.replacement.reasoning) > 0 } |> should.be_true
  { string.length(report.empathy.reasoning) > 0 } |> should.be_true
  { string.length(report.actionable.reasoning) > 0 } |> should.be_true
  { string.length(report.discoverable.reasoning) > 0 } |> should.be_true
  { string.length(report.yet_complete.reasoning) > 0 } |> should.be_true
}

pub fn analyze_ready_generates_blockers_test() {
  // Contract: Low dimension scores generate appropriate blockers
  let spec = minimal_spec()

  let report = ready.analyze_ready(spec)

  // Should have blockers
  { list.length(report.blockers) > 0 } |> should.be_true

  // At least one should be Critical or High severity
  let has_high_severity =
    report.blockers
    |> list.any(fn(b) {
      case b.severity {
        Critical -> True
        High -> True
        _ -> False
      }
    })

  has_high_severity |> should.be_true
}

pub fn analyze_ready_generates_recommendations_test() {
  // Contract: Medium scores generate prioritized recommendations
  let spec = minimal_spec()

  let report = ready.analyze_ready(spec)

  // Should have recommendations
  { list.length(report.recommendations) > 0 } |> should.be_true

  // Recommendations should have priorities
  let all_have_priorities =
    report.recommendations
    |> list.all(fn(r) { r.priority > 0 })

  all_have_priorities |> should.be_true
}

