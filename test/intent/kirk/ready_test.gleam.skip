  // Contract: Short description (<=50 chars) reduces replacement score
  let spec = Spec(..minimal_spec(), description: "Short desc")

  let report = ready.analyze_ready(spec)

  // Should be penalized
  { report.replacement.score < 100 } |> should.be_true
