  // Contract: < 3 success criteria reduces replacement score
  let spec = Spec(..minimal_spec(), success_criteria: ["One criterion"])

  let report = ready.analyze_ready(spec)

  // Should be penalized for insufficient criteria
  { report.replacement.score < 100 } |> should.be_true
}

