pub fn analyze_empathy_no_error_behaviors_test() {
  // Contract: No 4xx status behaviors produces low empathy score
  let behavior =
    Behavior(
      name: "get-user",
      intent: "Get user",
      notes: "",
      requires: [],
      tags: [],
      request: Request(
        method: Get,
        path: "/users/1",
        headers: dict.new(),
        query: dict.new(),
        body: json.null(),
      ),
      response: Response(
        status: 200,
        example: json.null(),
        checks: dict.new(),
        headers: dict.new(),
      ),
      captures: dict.new(),
    )

  let spec = test_helpers.make_test_spec_from_behaviors([behavior])

  let report = ready.analyze_ready(spec)

  // Empathy score should be low without error handling
  { report.empathy.score < 50 } |> should.be_true
}

pub fn analyze_empathy_has_error_behaviors_test() {
  // Contract: Multiple 4xx behaviors increase empathy score
  let behaviors = [
    test_helpers.make_test_behavior_with_status("not-found", 404, []),
    test_helpers.make_test_behavior_with_status("bad-request", 400, []),
    test_helpers.make_test_behavior_with_status("unauthorized", 401, []),
  ]

  let spec = test_helpers.make_test_spec_from_behaviors(behaviors)

  let report = ready.analyze_ready(spec)

  // Empathy score should be relatively high
  { report.empathy.score >= 70 } |> should.be_true
}

pub fn analyze_empathy_has_anti_patterns_test() {
  // Contract: 2+ anti_patterns boost empathy score
  let spec =
    Spec(..minimal_spec(), anti_patterns: [
      AntiPattern(pattern: "pattern1", description: "desc1", why: "why1"),
      AntiPattern(pattern: "pattern2", description: "desc2", why: "why2"),
    ])

  let report = ready.analyze_ready(spec)

  // Anti-patterns should boost empathy
  // (compared to spec without them)
  let spec_without = Spec(..minimal_spec(), anti_patterns: [])
  let report_without = ready.analyze_ready(spec_without)

  { report.empathy.score > report_without.empathy.score } |> should.be_true
}

pub fn analyze_empathy_has_validation_keywords_test() {
  // Contract: Validation keywords in intent/notes boost empathy
  let behavior =
    Behavior(
      name: "validate-user",
      intent: "Validate user input before processing",
      notes: "Check email format and verify password strength",
      requires: [],
      tags: [],
      request: Request(
        method: Get,
        path: "/validate",
        headers: dict.new(),
        query: dict.new(),
        body: json.null(),
      ),
      response: Response(
        status: 200,
        example: json.null(),
        checks: dict.new(),
        headers: dict.new(),
      ),
      captures: dict.new(),
    )

  let spec = test_helpers.make_test_spec_from_behaviors([behavior])

  let report = ready.analyze_ready(spec)

  // Should get validation bonus
  // (Base score should be improved by validation keywords)
  { report.empathy.score > 0 } |> should.be_true
}

