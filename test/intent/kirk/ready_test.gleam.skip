  // Should contain score values
  let replacement_str = int.to_string(report.replacement.score)
  let empathy_str = int.to_string(report.empathy.score)

  { string.contains(formatted, replacement_str) } |> should.be_true
  { string.contains(formatted, empathy_str) } |> should.be_true
}

pub fn format_report_includes_blockers_test() {
