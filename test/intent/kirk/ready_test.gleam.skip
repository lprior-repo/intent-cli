pub fn format_report_produces_output_test() {
  // Contract: format_report produces non-empty string
  let spec = test_helpers.make_test_spec_from_behaviors([])

  let report = ready.analyze_ready(spec)
  let formatted = ready.format_report(report)

  // Should be non-empty
  formatted |> string.is_empty |> should.be_false
}

pub fn format_report_includes_header_test() {
  // Contract: Output contains READY Framework header
  let spec = test_helpers.make_test_spec_from_behaviors([])

  let report = ready.analyze_ready(spec)
  let formatted = ready.format_report(report)

  // Should contain READY or Framework
  let lower = string.lowercase(formatted)
  { string.contains(lower, "ready") || string.contains(lower, "framework") }
  |> should.be_true
}

