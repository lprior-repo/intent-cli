pub fn format_report_readiness_labels_test() {
  // Contract: Output shows correct readiness label based on score
  let spec = complete_spec()

  let report = ready.analyze_ready(spec)
  let formatted = ready.format_report(report)

  // Should contain a readiness label
  let lower = string.lowercase(formatted)
  let has_label =
    string.contains(lower, "launch")
    || string.contains(lower, "production")
    || string.contains(lower, "beta")
    || string.contains(lower, "rework")

  has_label |> should.be_true
}
