pub fn analyze_yet_complete_incomplete_test() {
  // Contract: Missing features, rules, ai_hints, config produces low score
  let spec = minimal_spec()

  let report = ready.analyze_ready(spec)

  // Should have low yet-complete score
  { report.yet_complete.score < 50 } |> should.be_true
}

pub fn analyze_yet_complete_features_without_behaviors_test() {
  // Contract: Features without behaviors reduce yet_complete score
  let empty_feature =
    Feature(name: "Empty", description: "No behaviors", behaviors: [])

  let spec = Spec(..minimal_spec(), features: [empty_feature])

  let report = ready.analyze_ready(spec)

  // Should be penalized
  { report.yet_complete.score < 75 } |> should.be_true
  // Should have issue about features without behaviors
  let has_issue =
    report.yet_complete.issues
    |> list.any(fn(issue) {
      string.contains(string.lowercase(issue), "behavior")
    })
  has_issue |> should.be_true
}

pub fn analyze_yet_complete_has_rules_test() {
  // Contract: Defined rules boost yet_complete score
  let spec =
    Spec(..minimal_spec(), rules: [
      Rule(
        name: "test-rule",
        condition: "true",
        constraint: "true",
        why: "For testing",
      ),
    ])

  let report = ready.analyze_ready(spec)

  // Should get rules bonus (25 points)
  let spec_without_rules = Spec(..minimal_spec(), rules: [])
  let report_without_rules = ready.analyze_ready(spec_without_rules)

  { report.yet_complete.score > report_without_rules.yet_complete.score }
  |> should.be_true
}

pub fn analyze_yet_complete_complete_test() {
  // Contract: All completeness criteria met produces score of 100
  let spec = complete_spec()

  let report = ready.analyze_ready(spec)

  // Should have perfect or near-perfect yet-complete score
  { report.yet_complete.score >= 75 } |> should.be_true
}

// =============================================================================
// OVERALL READINESS CALCULATION
// =============================================================================

pub fn calculate_overall_readiness_weighted_average_test() {
  // Contract: Overall = R(25%) + E(20%) + A(20%) + D(15%) + Y(20%)
  let spec = complete_spec()

  let report = ready.analyze_ready(spec)

  // Calculate expected overall
  let expected =
    int.to_float(report.replacement.score)
    *. 0.25
    +. int.to_float(report.empathy.score)
    *. 0.2
    +. int.to_float(report.actionable.score)
    *. 0.2
    +. int.to_float(report.discoverable.score)
    *. 0.15
    +. int.to_float(report.yet_complete.score)
    *. 0.2

  let expected_rounded = float.round(expected)

  // Should match within rounding tolerance
  let diff =
    float.absolute_value(
      int.to_float(report.overall_readiness) -. int.to_float(expected_rounded),
    )
  { diff <=. 1.0 } |> should.be_true
}

pub fn calculate_overall_readiness_all_zero_test() {
  // Contract: All dimensions zero produces overall of 0
  let spec = Spec(..minimal_spec(), features: [])

  let report = ready.analyze_ready(spec)

  // With no features, many dimensions should be 0 or very low
  // Overall should be very low
  { report.overall_readiness < 30 } |> should.be_true
}

pub fn calculate_overall_readiness_all_hundred_test() {
  // Contract: Perfect spec approaches 100
  let spec = complete_spec()

  let report = ready.analyze_ready(spec)

  // Complete spec should have high overall readiness
  { report.overall_readiness >= 70 } |> should.be_true
}

// =============================================================================
// BLOCKER GENERATION
// =============================================================================

pub fn generate_blockers_overall_below_70_test() {
  // Contract: Overall readiness < 70 generates Critical blocker
  let spec = minimal_spec()

  let report = ready.analyze_ready(spec)

  // Verify low overall readiness
  { report.overall_readiness < 70 } |> should.be_true

  // Should have Critical blocker
  let has_critical_overall =
    report.blockers
    |> list.any(fn(b) {
      b.severity == Critical
      && string.contains(string.lowercase(b.description), "overall")
    })

  has_critical_overall |> should.be_true
}

pub fn generate_blockers_dimension_below_40_test() {
  // Contract: Dimension score < 40 generates Critical blocker
  let spec = minimal_spec()

  let report = ready.analyze_ready(spec)

  // At least one dimension should be < 40 in minimal spec
  let has_low_dimension =
    report.replacement.score < 40
    || report.empathy.score < 40
    || report.actionable.score < 40
    || report.discoverable.score < 40
    || report.yet_complete.score < 40

  { has_low_dimension } |> should.be_true

  // Should have Critical blocker for dimension
  let has_critical =
    report.blockers
    |> list.any(fn(b) { b.severity == Critical })

  has_critical |> should.be_true
}

pub fn generate_blockers_no_blockers_test() {
  // Contract: High scores (>=75) produce no or few blockers
  let spec = complete_spec()

  let report = ready.analyze_ready(spec)

  // Should have minimal or no blockers
  { list.length(report.blockers) <= 3 } |> should.be_true
}

// =============================================================================
// RECOMMENDATION GENERATION
// =============================================================================

pub fn generate_recommendations_sorted_by_priority_test() {
  // Contract: Recommendations sorted by priority (ascending)
  let spec = minimal_spec()

  let report = ready.analyze_ready(spec)

  // Should have recommendations
  { list.length(report.recommendations) > 0 } |> should.be_true

  // Verify sorted
  let is_sorted = fn(recs, prev_priority) {
    case recs {
      [] -> True
      [first, ..rest] -> {
        case first.priority >= prev_priority {
          True -> is_sorted(rest, first.priority)
          False -> False
        }
      }
    }
  }

  case report.recommendations {
    [] -> True
    [first, ..rest] -> is_sorted(rest, first.priority)
  }
  |> should.be_true
}

pub fn generate_recommendations_no_recommendations_test() {
  // Contract: High scores (>=75) produce no or few recommendations
  let spec = complete_spec()

  let report = ready.analyze_ready(spec)

  // Should have minimal or no recommendations
  { list.length(report.recommendations) <= 5 } |> should.be_true
}

