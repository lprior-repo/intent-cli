// ============================================================================
// Real Example Loading Tests
// ============================================================================

pub fn loader_load_real_user_api_spec_test() {
  // Test loading the real user-api.cue example
  let result = loader.load_spec("examples/user-api.cue")

  case result {
    Ok(spec) -> {
      spec.name
      |> should.equal("User Management API")

      spec.description
      |> should.contain("API manages user accounts")

      spec.audience
      |> should.equal("Mobile and web clients")

      spec.version
      |> should.equal("1.0.0")

      // Verify we have features
      let features = spec.features
      list.length(features)
      |> should.equal(3) // Registration, Authentication, Profile Management

      // Verify behaviors in first feature
      let first_feature = list.first(features)
      case first_feature {
        Ok(feature) -> {
          let behaviors = feature.behaviors
          list.length(behaviors)
          |> should.equal(4) // successful-registration, duplicate-email-rejected, etc.
        }
        Error(_) -> should.fail()
      }

      // Verify rules
      let rules = spec.rules
      list.length(rules)
      |> should.equal(3) // no-sensitive-data, structured-errors, content-type-header

      // Verify anti_patterns
      let anti_patterns = spec.anti_patterns
      list.length(anti_patterns)
      |> should.equal(3) // password-in-response, user-enumeration, plain-text-ids

      // Verify ai_hints
      let ai_hints = spec.ai_hints
      ai_hints.implementation.suggested_stack
      |> should.contain("Node.js")
    }
    Error(_) -> should.fail()
  }
}

pub fn loader_load_real_pokemon_api_spec_test() {
  // Test loading another real example
  let result = loader.load_spec("examples/pokemon-api.cue")

  case result {
    Ok(spec) -> {
      spec.name
      |> should.equal("PokéAPI")

      list.length(spec.features)
      |> should.greater_than(0)

      list.length(spec.rules)
      |> should.greater_than(0)
    }
    Error(_) -> should.fail()
  }
}

// ============================================================================
// Error Handling Tests
// ============================================================================

pub fn loader_handle_empty_path_test() {
  // Test empty path
  let result = loader.load_spec("")

  case result {
    Error(loader.FileNotFound(_)) -> should.be_ok(Ok(Nil))
    _ -> should.fail()
  }
}

pub fn loader_handle_whitespace_only_path_test() {
  // Test whitespace-only path
  let result = loader.load_spec("   ")

  case result {
    Error(loader.FileNotFound(_)) -> should.be_ok(Ok(Nil))
    _ -> should.fail()
  }
}

pub fn loader_handle_directory_path_test() {
  // Test passing a directory instead of file
  let result = loader.load_spec("/tmp")

  case result {
    Error(loader.FileNotFound(_)) -> should.be_ok(Ok(Nil))
    _ -> should.fail()
  }
}

// ============================================================================
// Security Validation Tests
// ============================================================================

pub fn loader_handle_potentially_malicious_path_test() {
  // Test paths that could be security risks
  let malicious_paths = [
    "/etc/passwd",
    "/root/.ssh/id_rsa",
    "/proc/self/environ",
    "../../etc/passwd",
    "~//.bashrc",
  ]

  list.fold(malicious_paths, True, fn(acc, path) {
    case acc {
      True -> {
        let result = loader.load_spec(path)
        // Security validation should reject these
        case result {
          Error(loader.FileNotFound(_)) -> True
          _ -> False
        }
      }
      False -> False
    }
  })
  |> should.be_true
}

// ============================================================================
// Performance and Edge Cases
// ============================================================================

pub fn loader_load_large_spec_test() {
  // Test loading a larger spec file (pokemon-api is complex)
  let result = loader.load_spec("examples/pokemon-api.cue")

  case result {
    Ok(spec) -> {
      // Performance: Should load within reasonable time
      // Content: Should have substantial data
      list.length(spec.features)
      |> should.greater_than(5)

      list.length(spec.rules)
      |> should.greater_than(3)

      list.length(spec.anti_patterns)
      |> should.greater_than(0)
    }
    Error(_) -> should.fail()
  }
}

pub fn loader_load_spec_with_complex_structure_test() {
  // Test loading spec with complex nested structures
  let result = loader.load_spec("examples/meal-planner-api.cue")

  case result {
    Ok(spec) -> {
      spec.name
      |> should.equal("Meal Planner API")

      // Should have complex behaviors with requirements
      let first_feature = list.first(spec.features)
      case first_feature {
        Ok(feature) -> {
          let has_complex_behavior = list.any(feature.behaviors, fn(behavior) {
            list.length(behavior.requires) > 0
          })
          has_complex_behavior
          |> should.be_true
        }
        Error(_) -> should.fail()
      }
    }
    Error(_) -> should.fail()
  }
}

