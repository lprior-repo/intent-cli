// ============================================================================
// Error Message Formatting Tests
// ============================================================================

pub fn loader_format_error_with_complex_path_test() {
  // Test error formatting with complex paths
  let error = loader.FileNotFound("/home/user/complex/path/with spaces/test spec.cue")
  let formatted = loader.format_error(error)

  formatted
  |> string.contains("test spec.cue")
  |> should.be_true

  formatted
  |> string.contains("File not found")
  |> should.be_true
}

pub fn loader_format_error_with_unicode_test() {
  // Test error formatting with unicode characters
  let error = loader.FileNotFound("/home/user/测试/规范.cue")
  let formatted = loader.format_error(error)

  formatted
  |> string.contains("测试")
  |> should.be_true

  formatted
  |> string.contains("规范.cue")
  |> should.be_true
}

pub fn loader_format_error_with_special_characters_test() {
  // Test error formatting with special characters
  let error = loader.CueValidationError("expected string, got <nil> at field 'config.base_url'")
  let formatted = loader.format_error(error)

  formatted
  |> string.contains("<nil>")
  |> should.be_true

  formatted
  |> string.contains("CUE validation failed")
  |> should.be_true
}