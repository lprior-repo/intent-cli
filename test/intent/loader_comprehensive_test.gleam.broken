//// Comprehensive tests for the CUE spec loader
//// Tests real CUE file loading with various scenarios including valid files,
//// invalid syntax, import resolution, and error handling

import gleeunit/should
import intent/loader.{type LoadError}
import intent/types.{type Spec}
// Temporarily commented out - os module not available

// ============================================================================
// Test Setup - Create temporary test files
// ============================================================================

pub fn setup() {
  // Create a temporary directory for test files
  // let temp_dir = os.temp_dir()

  // Create a minimal valid CUE spec for testing
  let minimal_valid_cue = """
package test_spec

spec: {
	name: "Test API"
	description: "A test API for testing"
	audience: "Test users"
	version: "1.0.0"
	success_criteria: ["Basic functionality"]
	config: {
		base_url: "http://localhost:8080"
		timeout_ms: 5000
	}
	features: [{
		name: "Test Feature"
		description: "A test feature"
		behaviors: [{
			name: "test-behavior"
			intent: "Test intent"
			request: {
				method: "GET"
				path: "/test"
			}
			response: {
				status: 200
				example: {
					message: "test"
				}
				checks: {
					"message": {
						rule: "equals test"
						why: "Test check"
					}
				}
			}
			notes: ""
			requires: []
			tags: []
			captures: {}
		}]
	}]
	rules: []
	anti_patterns: []
	ai_hints: {
		implementation: {suggested_stack: []}
		entities: {}
		security: {}
		pitfalls: []
	}
}
"""

  // Create a CUE file with invalid syntax
  let invalid_syntax_cue = """
package test_spec

spec: {
	name: "Test API"
	description: "A test API"
	// Missing required fields
	config: {
		base_url: "http://localhost:8080"
	}
	// Missing required fields like success_criteria, features, etc.
}
"""

  // Create a CUE file with missing spec field
  let missing_spec_field_cue = """
package test_spec

// No 'spec' field defined
name: "Test API"
description: "A test API"
"""

  // Create a valid CUE with import (this will fail if import not available)
  let with_import_cue = """
package test_spec

import "github.com/intent-cli/intent/schema:intent"

spec: intent.#Spec & {
	name: "Test API with Import"
	description: "A test API with import"
	audience: "Test users"
	version: "1.0.0"
	success_criteria: ["Basic functionality"]
	config: {
		base_url: "http://localhost:8080"
		timeout_ms: 5000
	}
	features: [{
		name: "Test Feature"
		description: "A test feature"
		behaviors: [{
			name: "test-behavior"
			intent: "Test intent"
			request: {
				method: "GET"
				path: "/test"
			}
			response: {
				status: 200
				example: {
					message: "test"
				}
				checks: {
					"message": {
						rule: "equals test"
						why: "Test check"
					}
				}
			}
			notes: ""
			requires: []
			tags: []
			captures: {}
		}]
	}]
	rules: []
	anti_patterns: []
	ai_hints: {
		implementation: {suggested_stack: []}
		entities: {}
		security: {}
		pitfalls: []
	}
}
"""

  // Write test files to temp directory
  let valid_file_path = temp_dir <> "/valid_spec.cue"
  let invalid_file_path = temp_dir <> "/invalid_spec.cue"
  let missing_spec_file_path = temp_dir <> "/missing_spec.cue"
  let import_file_path = temp_dir <> "/with_import.cue"

  os.write(valid_file_path, minimal_valid_cue)
  os.write(invalid_file_path, invalid_syntax_cue)
  os.write(missing_spec_file_path, missing_spec_field_cue)
  os.write(import_file_path, with_import_cue)

  // Return file paths for use in tests
  #(valid_file_path, invalid_file_path, missing_spec_file_path, import_file_path)
}

pub fn cleanup(temp_dir: String) {
  // Clean up test files
  os.remove(temp_dir <> "/valid_spec.cue")
  os.remove(temp_dir <> "/invalid_spec.cue")
  os.remove(temp_dir <> "/missing_spec.cue")
  os.remove(temp_dir <> "/with_import.cue")
}

// ============================================================================
// Valid CUE File Loading Tests
// ============================================================================

pub fn loader_load_valid_cue_spec_test() {
  let #(valid_file_path, _, _, _) = setup()

  // Test loading a valid CUE spec
  let result = loader.load_spec(valid_file_path)

  case result {
    Ok(spec) -> {
      // Verify the loaded spec has expected properties
      spec.name
      |> should.equal("Test API")

      spec.description
      |> should.equal("A test API for testing")

      spec.audience
      |> should.equal("Test users")

      spec.version
      |> should.equal("1.0.0")

      spec.success_criteria
      |> should.equal(["Basic functionality"])

      // Verify features structure
      let features = spec.features
      list.length(features)
      |> should.equal(1)

      let first_feature = list.first(features)
      case first_feature {
        Ok(feature) -> {
          feature.name
          |> should.equal("Test Feature")

          let behaviors = feature.behaviors
          list.length(behaviors)
          |> should.equal(1)

          let first_behavior = list.first(behaviors)
          case first_behavior {
            Ok(behavior) -> {
              behavior.name
              |> should.equal("test-behavior")
              behavior.intent
              |> should.equal("Test intent")

              behavior.request.method
              |> should.equal("GET")
              behavior.request.path
              |> should.equal("/test")

              behavior.response.status
              |> should.equal(200)
            }
            Error(_) -> should.fail()
          }
        }
        Error(_) -> should.fail()
      }
    }
    Error(_) -> should.fail()
  }

  cleanup(valid_file_path)
}

pub fn loader_load_valid_cue_spec_quiet_test() {
  let #(valid_file_path, _, _, _) = setup()

  // Test loading with quiet mode
  let result = loader.load_spec_quiet(valid_file_path)

  case result {
    Ok(spec) -> {
      spec.name
      |> should.equal("Test API")

      spec.audience
      |> should.equal("Test users")
    }
    Error(_) -> should.fail()
  }

  cleanup(valid_file_path)
}

// ============================================================================
// CUE Validation Tests
// ============================================================================

pub fn loader_validate_valid_cue_test() {
  let #(valid_file_path, _, _, _) = setup()

  // Test validation of a valid CUE file
  let result = loader.validate_cue(valid_file_path)

  case result {
    Ok(_) -> should.be_ok(Ok(Nil)) // Should succeed
    Error(_) -> should.fail()
  }

  cleanup(valid_file_path)
}

pub fn loader_validate_invalid_cue_syntax_test() {
  let #(_, invalid_file_path, _, _) = setup()

  // Test validation of invalid CUE syntax
  let result = loader.validate_cue(invalid_file_path)

  case result {
    Error(_) -> should.be_ok(Ok(Nil)) // Should fail
    Ok(_) -> should.fail()
  }

  cleanup(invalid_file_path)
}

pub fn loader_validate_nonexistent_file_test() {
  // Test validation of non-existent file
  let result = loader.validate_cue("/nonexistent/file.cue")

  case result {
    Error(_) -> should.be_ok(Ok(Nil)) // Should fail
    Ok(_) -> should.fail()
  }
}

