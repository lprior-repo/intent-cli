pub fn category_pattern_matching_test() {
  let categories = [
    HappyPath, ErrorCase, EdgeCase, Constraint, Dependency, NonFunctional,
  ]

  let count = categories
  |> list.count(fn(c) {
    case c {
      HappyPath -> True
      ErrorCase -> True
      EdgeCase -> True
      Constraint -> True
      Dependency -> True
      NonFunctional -> True
    }
