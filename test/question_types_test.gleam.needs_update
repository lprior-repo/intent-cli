//// Tests for question_types module
//// Validates all type constructors and pattern matching functionality

import gleeunit
import gleeunit/should
import intent/question_types.{
  type Perspective, type QuestionCategory, type QuestionPriority, type Question,
  User, Developer, Ops, Security, Business, HappyPath, ErrorCase, EdgeCase,
  Constraint, Dependency, NonFunctional, Critical, Important, NiceTohave,
  Question,
}

pub fn main() {
  gleeunit.main()
}

// ============================================================================
// Perspective Type Tests
// ============================================================================

pub fn perspective_user_test() {
  User
  |> should.equal(User)
}

pub fn perspective_developer_test() {
  Developer
  |> should.equal(Developer)
}

pub fn perspective_ops_test() {
  Ops
  |> should.equal(Ops)
}

pub fn perspective_security_test() {
  Security
  |> should.equal(Security)
}

pub fn perspective_business_test() {
  Business
  |> should.equal(Business)
}

pub fn perspective_pattern_matching_test() {
  let perspectives = [User, Developer, Ops, Security, Business]

  let count = perspectives
  |> list.count(fn(p) {
    case p {
      User -> True
      Developer -> True
      Ops -> True
      Security -> True
      Business -> True
    }
  })

  count
  |> should.equal(5)
}

