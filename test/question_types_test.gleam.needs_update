// ============================================================================
// Question Type Tests - Pattern Matching
// ============================================================================

pub fn question_pattern_match_all_fields_test() {
  let q = Question(
    id: "q-test",
    round: 3,
    perspective: Security,
    category: Constraint,
    priority: Important,
    question: "Security question",
    context: "SSL validation",
    example: "https request",
    expected_type: "Response",
    extract_into: ["cert"],
    depends_on: ["q-setup"],
    blocks: ["q-teardown"],
  )

  case q {
    Question(
      id: id,
      round: round,
      perspective: Security,
      category: Constraint,
      priority: Important,
      ..
    ) -> {
      id
      |> should.equal("q-test")
      round
      |> should.equal(3)
    }
    _ -> should.fail()
  }
}

pub fn question_perspective_exhaustive_match_test() {
  let test_question = fn(p: Perspective) -> String {
    case p {
      User -> "user"
      Developer -> "developer"
      Ops -> "ops"
      Security -> "security"
      Business -> "business"
    }
  }

  test_question(User)
  |> should.equal("user")
  test_question(Developer)
  |> should.equal("developer")
  test_question(Ops)
  |> should.equal("ops")
  test_question(Security)
  |> should.equal("security")
  test_question(Business)
  |> should.equal("business")
}

pub fn question_category_exhaustive_match_test() {
  let test_category = fn(c: QuestionCategory) -> String {
    case c {
      HappyPath -> "happy"
      ErrorCase -> "error"
      EdgeCase -> "edge"
      Constraint -> "constraint"
      Dependency -> "dependency"
      NonFunctional -> "nonfunctional"
    }
  }

  test_category(HappyPath)
  |> should.equal("happy")
  test_category(ErrorCase)
  |> should.equal("error")
  test_category(EdgeCase)
  |> should.equal("edge")
  test_category(Constraint)
  |> should.equal("constraint")
  test_category(Dependency)
  |> should.equal("dependency")
  test_category(NonFunctional)
  |> should.equal("nonfunctional")
}

pub fn question_priority_exhaustive_match_test() {
  let test_priority = fn(p: QuestionPriority) -> Int {
    case p {
      Critical -> 1
      Important -> 2
      NiceTohave -> 3
    }
  }

  test_priority(Critical)
  |> should.equal(1)
  test_priority(Important)
  |> should.equal(2)
  test_priority(NiceTohave)
  |> should.equal(3)
}

// ============================================================================
// Complex Scenario Tests
// ============================================================================

pub fn multiple_questions_list_test() {
  let q1 = Question(
    id: "q1",
    round: 1,
    perspective: User,
    category: HappyPath,
    priority: Critical,
    question: "Q1",
    context: "C1",
    example: "E1",
    expected_type: "T1",
    extract_into: [],
    depends_on: [],
    blocks: ["q2"],
  )

  let q2 = Question(
    id: "q2",
    round: 2,
    perspective: Developer,
    category: ErrorCase,
    priority: Important,
    question: "Q2",
    context: "C2",
    example: "E2",
    expected_type: "T2",
    extract_into: ["value"],
    depends_on: ["q1"],
    blocks: [],
  )

  let questions = [q1, q2]

  questions
  |> list.length()
  |> should.equal(2)
}

pub fn question_filtering_by_perspective_test() {
  let q1 = Question(
    id: "q1",
    round: 1,
    perspective: User,
    category: HappyPath,
    priority: Critical,
    question: "Q1",
    context: "C1",
    example: "E1",
    expected_type: "T1",
    extract_into: [],
    depends_on: [],
    blocks: [],
  )

  let q2 = Question(
    id: "q2",
    round: 1,
    perspective: Developer,
    category: HappyPath,
    priority: Critical,
    question: "Q2",
    context: "C2",
    example: "E2",
    expected_type: "T2",
    extract_into: [],
    depends_on: [],
    blocks: [],
  )

  let questions = [q1, q2]

  let user_questions = questions
  |> list.filter(fn(q) {
    case q.perspective {
      User -> True
      _ -> False
    }
  })

  user_questions
  |> list.length()
  |> should.equal(1)
}

pub fn question_filtering_by_priority_test() {
  let q1 = Question(
    id: "q1",
    round: 1,
    perspective: User,
    category: HappyPath,
    priority: Critical,
    question: "Q1",
    context: "C1",
    example: "E1",
    expected_type: "T1",
    extract_into: [],
    depends_on: [],
    blocks: [],
  )

  let q2 = Question(
    id: "q2",
    round: 1,
    perspective: User,
    category: HappyPath,
    priority: NiceTohave,
    question: "Q2",
    context: "C2",
    example: "E2",
    expected_type: "T2",
    extract_into: [],
    depends_on: [],
    blocks: [],
  )

  let questions = [q1, q2]

  let critical_questions = questions
  |> list.filter(fn(q) {
    case q.priority {
      Critical -> True
      _ -> False
    }
  })

  critical_questions
  |> list.length()
  |> should.equal(1)
}

pub fn question_with_dependencies_test() {
  let q_setup = Question(
    id: "setup",
    round: 1,
    perspective: Developer,
    category: HappyPath,
    priority: Critical,
    question: "Setup",
    context: "Setup context",
    example: "Setup example",
    expected_type: "T",
    extract_into: ["token"],
    depends_on: [],
    blocks: ["q1"],
  )

  let q_main = Question(
    id: "q1",
    round: 2,
    perspective: User,
    category: HappyPath,
    priority: Critical,
    question: "Main",
    context: "Main context",
    example: "Main example",
    expected_type: "T",
    extract_into: [],
    depends_on: ["setup"],
    blocks: [],
  )

  q_main.depends_on
  |> list.contains("setup")
  |> should.be_true()

  q_setup.blocks
  |> list.contains("q1")
  |> should.be_true()
}

pub fn question_round_sequence_test() {
  let q1 = Question(
    id: "q1",
    round: 1,
    perspective: User,
    category: HappyPath,
    priority: Critical,
    question: "Q1",
    context: "C",
    example: "E",
    expected_type: "T",
    extract_into: [],
    depends_on: [],
    blocks: [],
  )

  let q2 = Question(
    id: "q2",
    round: 2,
    perspective: User,
    category: HappyPath,
    priority: Critical,
    question: "Q2",
    context: "C",
    example: "E",
    expected_type: "T",
    extract_into: [],
    depends_on: [],
    blocks: [],
  )

  let q3 = Question(
    id: "q3",
    round: 3,
    perspective: User,
    category: HappyPath,
    priority: Critical,
    question: "Q3",
    context: "C",
    example: "E",
    expected_type: "T",
    extract_into: [],
    depends_on: [],
    blocks: [],
  )

  let questions = [q1, q2, q3]

  let max_round = questions
  |> list.fold(0, fn(max, q) {
    case q.round > max {
      True -> q.round
      False -> max
    }
  })

  max_round
  |> should.equal(3)
}
