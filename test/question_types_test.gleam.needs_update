pub fn question_construction_basic_test() {
  let q = Question(
    id: "q1",
    round: 1,
    perspective: User,
    category: HappyPath,
    priority: Critical,
    question: "What does the API return?",
    context: "Testing basic response",
    example: "GET /api/users -> 200 OK",
    expected_type: "JSON",
    extract_into: [],
    depends_on: [],
    blocks: [],
  )

  q.id
  |> should.equal("q1")
}

