// Test: build_spec_body composition
pub fn build_spec_from_session_body_composition_test() {
  let session =
    interview.InterviewSession(
      id: "test-5",
      profile: interview.Cli,
      created_at: "2024-01-01T00:00:00Z",
      updated_at: "2024-01-01T00:00:00Z",
      completed_at: "2024-01-01T00:00:00Z",
      stage: interview.Complete,
      rounds_completed: 1,
      answers: [
        Answer(
          question_id: "q1",
          question_text: "What feature?",
          perspective: Critical,
          round: 1,
          response: "File upload",
          extracted: dict.new(),
          confidence: 0.9,
          notes: "",
          timestamp: "2024-01-01T00:00:00Z",
        ),
        Answer(
          question_id: "q2",
          question_text: "What endpoint?",
          perspective: Critical,
          round: 1,
          response: "POST /upload",
          extracted: dict.new(),
          confidence: 0.9,
          notes: "",
          timestamp: "2024-01-01T00:00:00Z",
        ),
        Answer(
          question_id: "q3",
          question_text: "What security?",
          perspective: Critical,
          round: 1,
          response: "API key required",
          extracted: dict.new(),
          confidence: 0.9,
          notes: "",
          timestamp: "2024-01-01T00:00:00Z",
        ),
      ],
      gaps: [],
      conflicts: [],
      raw_notes: "",
    )

  let cue = spec_builder.build_spec_from_session(session)

  // Verify structure contains all sections
  string.contains(cue, "features:")
  |> should.be_true()

  string.contains(cue, "behaviors:")
  |> should.be_true()

  string.contains(cue, "security:")
  |> should.be_true()
}
