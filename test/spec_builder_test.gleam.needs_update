import gleam/dict
import gleam/int
import gleam/json
import gleam/list
import gleam/string
import gleeunit/should
import intent/interview.{Answer}
import intent/question_types.{Critical}
import intent/spec_builder

// Test: extract_features_from_answers with matching feature questions
pub fn extract_features_finds_feature_questions_test() {
  let answers = [
    Answer(
      question_id: "q1",
      question_text: "What are the main features?",
      perspective: Critical,
      round: 1,
      response: "User authentication",
      extracted: dict.new(),
      confidence: 0.9,
      notes: "",
      timestamp: "2024-01-01T00:00:00Z",
    ),
    Answer(
      question_id: "q2",
      question_text: "What capabilities does it need?",
      perspective: Critical,
      round: 1,
      response: "Data export",
      extracted: dict.new(),
      confidence: 0.9,
      notes: "",
      timestamp: "2024-01-01T00:00:00Z",
    ),
  ]

  let features = spec_builder.extract_features_from_answers(answers)

  list.length(features)
  |> should.equal(2)

  list.contains(features, "User authentication")
  |> should.be_true()

  list.contains(features, "Data export")
  |> should.be_true()
}

// Test: extract_features_from_answers ignores non-feature questions
pub fn extract_features_ignores_non_feature_questions_test() {
  let answers = [
    Answer(
