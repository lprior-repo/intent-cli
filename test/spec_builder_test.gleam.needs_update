// Test: extract_behaviors_from_answers with endpoint/path/method questions
pub fn extract_behaviors_finds_api_questions_test() {
  let answers = [
    Answer(
      question_id: "q1",
      question_text: "What endpoints do you need?",
      perspective: Critical,
      round: 1,
      response: "GET /api/users",
      extracted: dict.new(),
      confidence: 0.9,
      notes: "",
      timestamp: "2024-01-01T00:00:00Z",
    ),
    Answer(
      question_id: "q2",
      question_text: "What HTTP methods?",
      perspective: Critical,
      round: 1,
      response: "POST, PUT, DELETE",
      extracted: dict.new(),
      confidence: 0.9,
      notes: "",
      timestamp: "2024-01-01T00:00:00Z",
    ),
  ]

  let behaviors = spec_builder.extract_behaviors_from_answers(answers, interview.Api)

  // Should contain behavior comment header
  string.contains(behaviors, "behaviors:")
  |> should.be_true()

  // Should include the question text
  string.contains(behaviors, "What endpoints do you need?")
  |> should.be_true()
}

// Test: extract_behaviors_from_answers with empty answers
pub fn extract_behaviors_empty_answers_test() {
  let behaviors = spec_builder.extract_behaviors_from_answers([], interview.Api)

  // Should return default behaviors section
  string.contains(behaviors, "behaviors:")
  |> should.be_true()

  string.contains(behaviors, "Add endpoint definitions")
  |> should.be_true()
}

