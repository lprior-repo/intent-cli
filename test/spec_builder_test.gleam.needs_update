// Test: build_spec_from_session generates valid CUE output
pub fn build_spec_from_session_generates_cue_test() {
  let session =
    interview.InterviewSession(
      id: "test-1",
      profile: interview.Api,
      created_at: "2024-01-01T00:00:00Z",
      updated_at: "2024-01-01T00:00:00Z",
      completed_at: "2024-01-01T00:00:00Z",
      stage: interview.Complete,
      rounds_completed: 1,
      answers: [
        Answer(
          question_id: "q1",
          question_text: "What features?",
          perspective: Critical,
          round: 1,
          response: "User Management",
          extracted: dict.new(),
          confidence: 0.9,
          notes: "",
          timestamp: "2024-01-01T00:00:00Z",
        ),
      ],
      gaps: [],
      conflicts: [],
      raw_notes: "",
    )

  let cue = spec_builder.build_spec_from_session(session)

  // Should start with package declaration
  string.contains(cue, "package api")
  |> should.be_true()

  // Should contain features section
  string.contains(cue, "features:")
  |> should.be_true()

  // Should contain behaviors section
  string.contains(cue, "behaviors:")
  |> should.be_true()

  // Should contain security section
  string.contains(cue, "security:")
  |> should.be_true()
}

