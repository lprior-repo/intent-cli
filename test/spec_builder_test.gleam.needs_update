// Test: create_test_spec generates correct number of behaviors
pub fn create_test_spec_generates_correct_behaviors_test() {
  let spec = spec_builder.create_test_spec(10)

  list.length(spec.features)
  |> should.equal(1)

  let assert [feature] = spec.features

  list.length(feature.behaviors)
  |> should.equal(10)
}

// Test: create_test_spec with zero behaviors
pub fn create_test_spec_zero_behaviors_test() {
  let spec = spec_builder.create_test_spec(0)

  list.length(spec.features)
  |> should.equal(1)

  let assert [feature] = spec.features

  list.length(feature.behaviors)
  |> should.equal(0)
}

// Test: create_test_spec with large number of behaviors
pub fn create_test_spec_large_number_test() {
  let spec = spec_builder.create_test_spec(100)

  let assert [feature] = spec.features

  list.length(feature.behaviors)
  |> should.equal(100)
}

// Test: create_test_spec behavior naming
pub fn create_test_spec_behavior_naming_test() {
  let spec = spec_builder.create_test_spec(5)

  let assert [feature] = spec.features

  let behavior_names =
    feature.behaviors
    |> list.map(fn(b) { b.name })

  list.contains(behavior_names, "b1")
  |> should.be_true()

  list.contains(behavior_names, "b5")
  |> should.be_true()
}

// Test: create_test_spec deterministic (same input = same output)
pub fn create_test_spec_deterministic_test() {
  let spec1 = spec_builder.create_test_spec(25)
  let spec2 = spec_builder.create_test_spec(25)

  spec1.name
  |> should.equal(spec2.name)

  let assert [feature1] = spec1.features
  let assert [feature2] = spec2.features

  list.length(feature1.behaviors)
  |> should.equal(list.length(feature2.behaviors))
}

// Test: create_test_spec returns valid Spec
pub fn create_test_spec_valid_spec_test() {
  let spec = spec_builder.create_test_spec(3)

  spec.name
  |> should.equal("test")

  spec.version
  |> should.equal("1.0.0")

  spec.description
  |> should.equal("test")

  spec.audience
  |> should.equal("test")
}

// Test: create_test_spec config is correct
pub fn create_test_spec_config_test() {
  let spec = spec_builder.create_test_spec(5)

  spec.config.base_url
  |> should.equal("http://test")

  spec.config.timeout_ms
  |> should.equal(1000)
}

// Test: check_many validates multiple behaviors
pub fn check_many_validates_behaviors_test() {
  let spec = spec_builder.create_test_spec(2)
  let assert [feature] = spec.features
  let behaviors = feature.behaviors

  let results = [
    http_client.ExecutionResult(
      behavior_name: "b1",
      status: 200,
      body: json.null(),
      headers: dict.new(),
      duration_ms: 100,
    ),
    http_client.ExecutionResult(
      behavior_name: "b2",
      status: 200,
      body: json.null(),
      headers: dict.new(),
      duration_ms: 100,
    ),
  ]

  let ctx = interpolate.new_context(dict.new(), dict.new())

  let check_results = spec_builder.check_many(behaviors, results, ctx)

  list.length(check_results)
  |> should.equal(2)
}

// Test: check_many with single behavior
pub fn check_many_single_behavior_test() {
  let spec = spec_builder.create_test_spec(1)
  let assert [feature] = spec.features
  let behaviors = feature.behaviors

  let results = [
    http_client.ExecutionResult(
      behavior_name: "b1",
      status: 200,
      body: json.null(),
      headers: dict.new(),
      duration_ms: 50,
    ),
  ]

  let ctx = interpolate.new_context(dict.new(), dict.new())

  let check_results = spec_builder.check_many(behaviors, results, ctx)

  list.length(check_results)
  |> should.equal(1)
}

