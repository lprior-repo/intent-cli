// Test: extract_security_requirements with auth/security/permission questions
pub fn extract_security_requirements_finds_security_questions_test() {
  let answers = [
    Answer(
      question_id: "q1",
      question_text: "What authentication method?",
      perspective: Critical,
      round: 1,
      response: "OAuth 2.0",
      extracted: dict.new(),
      confidence: 0.9,
      notes: "",
      timestamp: "2024-01-01T00:00:00Z",
    ),
    Answer(
      question_id: "q2",
      question_text: "What security requirements?",
      perspective: Critical,
      round: 1,
      response: "HTTPS only",
      extracted: dict.new(),
      confidence: 0.9,
      notes: "",
      timestamp: "2024-01-01T00:00:00Z",
    ),
  ]

  let security = spec_builder.extract_security_requirements(answers)

  string.contains(security, "security:")
  |> should.be_true()

  string.contains(security, "requirement:")
  |> should.be_true()
}

