      perspective: Critical,
      round: 1,
      response: "Max 100 requests per minute",
      extracted: dict.new(),
      confidence: 0.9,
      notes: "",
      timestamp: "2024-01-01T00:00:00Z",
    ),
    Answer(
      question_id: "q2",
      question_text: "What limits do we have?",
      perspective: Critical,
      round: 1,
      response: "Request size < 1MB",
      extracted: dict.new(),
      confidence: 0.9,
      notes: "",
      timestamp: "2024-01-01T00:00:00Z",
