// Test: extract_non_functional_requirements
pub fn extract_non_functional_requirements_test() {
  let answers = [
    Answer(
      question_id: "q1",
      question_text: "What SLA do you need?",
      perspective: Critical,
      round: 1,
      response: "99.9% uptime",
      extracted: dict.new(),
      confidence: 0.9,
      notes: "",
      timestamp: "2024-01-01T00:00:00Z",
    ),
    Answer(
      question_id: "q2",
      question_text: "What performance requirements?",
      perspective: Critical,
      round: 1,
      response: "< 100ms latency",
      extracted: dict.new(),
      confidence: 0.9,
      notes: "",
      timestamp: "2024-01-01T00:00:00Z",
    ),
    Answer(
      question_id: "q3",
      question_text: "What monitoring?",
      perspective: Critical,
      round: 1,
      response: "Prometheus metrics",
      extracted: dict.new(),
      confidence: 0.9,
      notes: "",
      timestamp: "2024-01-01T00:00:00Z",
    ),
  ]

  let nf_reqs = spec_builder.extract_non_functional_requirements(answers)

  list.length(nf_reqs)
  |> should.equal(3)

  list.contains(nf_reqs, "99.9% uptime")
  |> should.be_true()

  list.contains(nf_reqs, "< 100ms latency")
  |> should.be_true()

  list.contains(nf_reqs, "Prometheus metrics")
  |> should.be_true()
}

