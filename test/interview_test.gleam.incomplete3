// Session Validation Tests
// ============================================================================

pub fn can_proceed_no_gaps_test() {
  let session = interview.create_session("test", Api, "2025-01-01T00:00:00Z")

  interview.can_proceed(session)
  |> should.be_ok
}

pub fn can_proceed_blocking_gap_test() {
  let gap = make_gap("gap1", "field1", True, False)
  let session =
    interview.create_session("test", Api, "2025-01-01T00:00:00Z")
    |> fn(s) {
      interview.InterviewSession(..s, gaps: [gap])
    }

  interview.can_proceed(session)
  |> should.be_error
}

