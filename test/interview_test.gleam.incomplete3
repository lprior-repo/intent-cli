pub fn format_progress_discovery_stage_test() {
  let session = interview.create_session("test", Api, "2025-01-01T00:00:00Z")

  let progress = interview.format_progress(session)

  progress
  |> should.equal("Profile: api | Stage: Discovery | Answers: 0 | Gaps: 0 | Conflicts: 0")
}

pub fn format_progress_complete_stage_test() {
  let session =
    interview.create_session("test", Api, "2025-01-01T00:00:00Z")
    |> interview.complete_round
    |> interview.complete_round
    |> interview.complete_round
    |> interview.complete_round
    |> interview.complete_round

  let progress = interview.format_progress(session)

  progress
  |> should.equal("Profile: api | Stage: Complete | Answers: 0 | Gaps: 0 | Conflicts: 0")
}
