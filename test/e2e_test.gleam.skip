    get_stdout(["quality", examples_dir <> "/user-api.cue", "--json=true"])
  let json_output = extract_json(output)

  case parse_json_output(json_output) {
    Ok(data) -> {
      let has_next_actions =
        data
        |> dynamic.field("next_actions", dynamic.list(dynamic.dynamic))
        |> result.is_ok()
      has_next_actions |> should.be_true()
    }
    Error(_) -> should.fail()
  }
}

// ============================================================================
// AI Pipeline Integration Tests
// ============================================================================

/// Test that all KIRK commands produce consistent JSON structure
pub fn e2e_ai_pipeline_consistent_json_structure_test() {
  let kirk_commands = ["quality", "coverage", "gaps", "invert", "effects"]
  let spec = examples_dir <> "/user-api.cue"

  // All commands should produce valid JSON with same top-level structure
  let all_valid =
    list.all(kirk_commands, fn(cmd) {
      let output = get_stdout([cmd, spec, "--json=true"])
      let json_output = extract_json(output)
      case parse_json_output(json_output) {
        Ok(data) -> {
          // Check required fields
          let has_success =
            data
            |> dynamic.field("success", dynamic.bool)
            |> result.is_ok()
          let has_action =
            data
            |> dynamic.field("action", dynamic.string)
            |> result.is_ok()
          let has_data =
            data
            |> dynamic.field("data", dynamic.dynamic)
            |> result.is_ok()
          let has_metadata =
            data
            |> dynamic.field("metadata", dynamic.dynamic)
            |> result.is_ok()
          has_success && has_action && has_data && has_metadata
        }
        Error(_) -> False
      }
    })

  all_valid |> should.be_true()
}

/// Test quality command JSON contains expected data fields
pub fn e2e_ai_quality_json_data_structure_test() {
  let output =
    get_stdout(["quality", examples_dir <> "/user-api.cue", "--json=true"])
  let json_output = extract_json(output)

  case parse_json_output(json_output) {
    Ok(data) -> {
      // Quality should have specific data fields
      let data_obj =
        data
        |> dynamic.field("data", dynamic.dynamic)
        |> result.unwrap(dynamic.from(0))

      let has_coverage_score =
        data_obj
        |> dynamic.field("coverage_score", dynamic.int)
        |> result.is_ok()
      let has_clarity_score =
        data_obj
        |> dynamic.field("clarity_score", dynamic.int)
        |> result.is_ok()
      let has_testability_score =
        data_obj
        |> dynamic.field("testability_score", dynamic.int)
        |> result.is_ok()

      has_coverage_score
      && has_clarity_score
      && has_testability_score
      |> should.be_true()
    }
    Error(_) -> should.fail()
  }
}

