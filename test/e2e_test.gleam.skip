/// Test AI pipeline: quality → gaps → invert workflow
pub fn e2e_ai_pipeline_quality_gaps_invert_workflow_test() {
  let spec = examples_dir <> "/user-api.cue"

  // Step 1: Run quality
  let quality_code = get_exit_code(["quality", spec, "--json=true"])
  quality_code |> should.equal(exit_pass)

  // Step 2: Run gaps
  let gaps_code = get_exit_code(["gaps", spec, "--json=true"])
  gaps_code |> should.equal(exit_pass)

  // Step 3: Run invert
  let invert_code = get_exit_code(["invert", spec, "--json=true"])
  invert_code |> should.equal(exit_pass)
}

/// Test AI pipeline: coverage → effects workflow
pub fn e2e_ai_pipeline_coverage_effects_workflow_test() {
  let spec = examples_dir <> "/user-api.cue"

  // Step 1: Run coverage
  let coverage_code = get_exit_code(["coverage", spec, "--json=true"])
  coverage_code |> should.equal(exit_pass)

  // Step 2: Run effects
  let effects_code = get_exit_code(["effects", spec, "--json=true"])
  effects_code |> should.equal(exit_pass)
}

/// Test that all KIRK commands work with different example specs
pub fn e2e_ai_commands_work_with_multiple_specs_test() {
  let specs = [
    examples_dir <> "/user-api.cue",
    examples_dir <> "/array-validation.cue",
    examples_dir <> "/regex-rules.cue",
  ]

  let commands = ["quality", "coverage", "gaps"]

  // All combinations should succeed
  let all_pass =
    list.all(specs, fn(spec) {
      list.all(commands, fn(cmd) {
        let code = get_exit_code([cmd, spec])
        code == exit_pass
      })
    })

  all_pass |> should.be_true()
}

