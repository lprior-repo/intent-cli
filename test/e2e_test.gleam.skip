/// Test that next_actions are provided for quality command
pub fn e2e_ai_quality_provides_next_actions_test() {
  let output =
    get_stdout(["quality", examples_dir <> "/user-api.cue", "--json=true"])
  let json_output = extract_json(output)

  case parse_json_output(json_output) {
    Ok(data) -> {
      // Should have next_actions array with at least one action
      case
        data |> dynamic.field("next_actions", dynamic.list(dynamic.dynamic))
      {
        Ok(actions) -> {
          let has_actions = list.length(actions) > 0
          has_actions |> should.be_true()
        }
        Error(_) -> should.fail()
      }
    }
    Error(_) -> should.fail()
  }
}

