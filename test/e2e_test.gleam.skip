/// Test that success field is boolean
pub fn e2e_ai_success_field_is_boolean_test() {
  let output =
    get_stdout(["quality", examples_dir <> "/user-api.cue", "--json=true"])
  let json_output = extract_json(output)

  case parse_json_output(json_output) {
    Ok(data) -> {
      let success_result = data |> dynamic.field("success", dynamic.bool)
      case success_result {
        Ok(success) -> {
          // Should be true for successful command
          success |> should.be_true()
        }
        Error(_) -> should.fail()
      }
    }
    Error(_) -> should.fail()
  }
}

/// Test that action field matches command name
pub fn e2e_ai_action_field_matches_command_test() {
  let commands_and_actions = [
    #("quality", "quality_result"),
    #("coverage", "coverage_result"),
    #("gaps", "gaps_result"),
    #("invert", "invert_result"),
    #("effects", "effects_result"),
  ]

  let all_match =
    list.all(commands_and_actions, fn(pair) {
      let #(cmd, expected_action) = pair
      let output =
        get_stdout([cmd, examples_dir <> "/user-api.cue", "--json=true"])
      let json_output = extract_json(output)

      case parse_json_output(json_output) {
        Ok(data) -> {
          let action =
            data
            |> dynamic.field("action", dynamic.string)
            |> result.unwrap("")
          action == expected_action
        }
        Error(_) -> False
      }
    })

  all_match |> should.be_true()
}

/// Test error handling: invalid spec path
pub fn e2e_ai_invalid_spec_path_returns_error_test() {
  let code = get_exit_code(["quality", "nonexistent.cue"])
  code |> should.equal(exit_error)
}

/// Test error handling: all KIRK commands fail gracefully with invalid spec
pub fn e2e_ai_commands_fail_gracefully_with_invalid_spec_test() {
  let commands = ["quality", "coverage", "gaps", "invert", "effects"]

  let all_fail_gracefully =
    list.all(commands, fn(cmd) {
      let code = get_exit_code([cmd, "nonexistent.cue"])
      code == exit_error
    })

  all_fail_gracefully |> should.be_true()
}
