// ============================================================================
// Parallel Processing Tests (AI-13)
// ============================================================================

/// Test: Parse batch JSON with parallel flag
/// RED: This will fail because parallel field doesn't exist yet
pub fn parse_batch_with_parallel_flag_test() {
  let json_content =
    "{\"profile\":\"api\",\"parallel\":true,\"answers\":[{\"question_id\":\"q1\",\"response\":\"Test\"}]}"

  let result = parse_batch_input_from_string(json_content)

  // Should parse successfully and extract parallel flag
  should.be_ok(result)

  case result {
    Ok(batch_input) -> {
      // RED: This will fail - BatchInput doesn't have parallel field yet
      batch_input.parallel |> should.equal(True)
    }
    Error(_) -> panic as "Expected Ok but got Error"
  }
}

/// Test: Parse batch JSON without parallel flag defaults to false
pub fn parse_batch_without_parallel_defaults_to_false_test() {
  let json_content =
    "{\"profile\":\"api\",\"answers\":[{\"question_id\":\"q1\",\"response\":\"Test\"}]}"

  let result = parse_batch_input_from_string(json_content)
  should.be_ok(result)

  case result {
    Ok(batch_input) -> {
      // RED: This will fail - BatchInput doesn't have parallel field yet
      batch_input.parallel |> should.equal(False)
    }
    Error(_) -> panic as "Expected Ok but got Error"
  }
}
