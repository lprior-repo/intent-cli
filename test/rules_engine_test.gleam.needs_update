// ============================================================================
// O. Multiple Rules Tests
// ============================================================================

/// Test: Multiple rules should all be checked
pub fn multiple_rules_all_pass_test() {
  let response = make_response(200, "ok", "GET", "/api/users")
  let rule1 = make_rule("rule1", "== 200", "GET", "/api/users")
  let rule2 = make_rule("rule2", ">= 200", "GET", "/api/users")

  check_rules([rule1, rule2], response, "test")
  |> should.equal([RulePassed("rule1"), RulePassed("rule2")])
}

/// Test: Multiple rules with one failure
pub fn multiple_rules_one_fails_test() {
  let response = make_response(200, "ok", "GET", "/api/users")
  let rule1 = make_rule("rule1", "== 200", "GET", "/api/users")
  let rule2 = make_rule("rule2", "== 404", "GET", "/api/users")

  let result = check_rules([rule1, rule2], response, "test")
  result
  |> should.have_length(2)
}

/// Test: Multiple rules with different paths
pub fn multiple_rules_different_paths_test() {
  let response = make_response(200, "ok", "GET", "/api/users")
  let rule1 = make_rule("rule1", "== 200", "GET", "/api/users")
  let rule2 = make_rule("rule2", "== 200", "GET", "/api/posts")

  check_rules([rule1, rule2], response, "test")
  |> should.equal([RulePassed("rule1")])
}

// ============================================================================
// P. Edge Cases
// ============================================================================

/// Test: Status code 0 should work
pub fn status_zero_test() {
  let response = make_response(0, "ok", "GET", "/api/users")
  let rule = make_rule("test", "== 0", "GET", "/api/users")

  check_rules([rule], response, "test")
  |> should.equal([RulePassed("test")])
}

/// Test: Large status code should work
pub fn status_large_number_test() {
  let response = make_response(599, "ok", "GET", "/api/users")
  let rule = make_rule("test", "== 599", "GET", "/api/users")

  check_rules([rule], response, "test")
  |> should.equal([RulePassed("test")])
}

/// Test: Negative status condition
pub fn status_negative_condition_test() {
  let response = make_response(0, "ok", "GET", "/api/users")
  let rule = make_rule("test", ">= -1", "GET", "/api/users")

  check_rules([rule], response, "test")
  |> should.equal([RulePassed("test")])
}

/// Test: Empty path pattern should match empty path
pub fn empty_path_pattern_test() {
  let response = make_response(200, "ok", "GET", "")
  let rule = make_rule("test", "== 200", "GET", "")

  check_rules([rule], response, "test")
  |> should.equal([RulePassed("test")])
}

/// Test: Path with special characters
pub fn path_with_special_chars_test() {
  let response = make_response(200, "ok", "GET", "/api/users?id=1&name=test")
  let rule = make_rule("test", "== 200", "GET", "/api/users\\?id=1&name=test")

  check_rules([rule], response, "test")
  |> should.equal([RulePassed("test")])
}
