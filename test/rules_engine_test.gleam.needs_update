}

// ============================================================================
// H. Body Must Contain Tests
// ============================================================================

/// Test: body_must_contain should pass when string is present
pub fn body_must_contain_found_test() {
  let response = make_response(200, "user created successfully", "GET", "/api/users")
  let rule_check = RuleCheck(
    body_must_not_contain: [],
    body_must_contain: ["created"],
    fields_must_exist: [],
    fields_must_not_exist: [],
    header_must_exist: "",
    header_must_not_exist: "",
  )
  let rule = Rule(
    name: "test",
    description: "Test rule",
    when: When(status: "== 200", method: Get, path: "/api/users"),
    check: rule_check,
    example: json.null(),
  )

  check_rules([rule], response, "test")
  |> should.equal([RulePassed("test")])
}

/// Test: body_must_contain should fail when string is missing
pub fn body_must_contain_missing_test() {
  let response = make_response(200, "ok", "GET", "/api/users")
  let rule_check = RuleCheck(
    body_must_not_contain: [],
    body_must_contain: ["created"],
    fields_must_exist: [],
    fields_must_not_exist: [],
    header_must_exist: "",
    header_must_not_exist: "",
  )
  let rule = Rule(
    name: "test",
    description: "Test rule",
    when: When(status: "== 200", method: Get, path: "/api/users"),
    check: rule_check,
    example: json.null(),
  )

  let result = check_rules([rule], response, "test")
  case result {
    [RuleFailed("test", _, [BodyMissing("created")])] -> Nil
    _ -> should.fail("Expected RuleFailed with BodyMissing")
  }
}

