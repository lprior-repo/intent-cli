//// Comprehensive tests for intent/rules_engine.gleam
//// Tests cover rule application, violation detection, and format_violation function.
////
//// Coverage:
//// - Rule application based on when conditions (status, method, path)
//// - Status condition parsing (==, >, >=, <, <=)
//// - Path pattern matching (exact and regex)
//// - Method matching
//// - Body checks (must contain, must not contain)
//// - Field existence checks (nested field navigation)
//// - Header existence checks (case-insensitive)
//// - Violation collection and formatting
//// - Edge cases (empty rules, case sensitivity, regex patterns)

import gleam/dict
import gleam/dynamic
import gleam/json
import gleam/list
import gleeunit
import gleeunit/should
import intent/http_client.{type ExecutionResult}
import intent/parser
import intent/rules_engine.{
  BodyContains, BodyMissing, FieldMissing, FieldPresent, HeaderMissing,
  HeaderPresent, RuleFailed, RulePassed, format_violation, check_rules,
}
import intent/types.{
  Get, Post, Put, Patch, Delete, Rule, RuleCheck, When,
}

pub fn main() {
  gleeunit.main()
}

// ============================================================================
// Helper Functions to Create Test Data
// ============================================================================

/// Create a basic execution result for testing
fn make_response(
  status: Int,
  body: String,
  _method: String,
  path: String,
) -> ExecutionResult {
  let parsed_body = case json.decode(body, dynamic.dynamic) {
    Ok(data) -> parser.dynamic_to_json(data)
    Error(_) -> json.null()
  }

  ExecutionResult(
    status: status,
    headers: dict.new(),
    body: parsed_body,
    raw_body: body,
    elapsed_ms: 100,
    request_method: Get,
    request_path: path,
  )
}

/// Create a basic rule for testing
fn make_rule(
  name: String,
  status_expr: String,
  _method: String,
  path_pattern: String,
) -> Rule {
  Rule(
    name: name,
    description: "Test rule",
    when: When(status: status_expr, method: Get, path: path_pattern),
    check: RuleCheck(
      body_must_not_contain: [],
      body_must_contain: [],
      fields_must_exist: [],
      fields_must_not_exist: [],
      header_must_exist: "",
      header_must_not_exist: "",
    ),
    example: json.null(),
  )
}

// ============================================================================
// A. Status Condition Tests - Exact Match
// ============================================================================

/// Test: Status "== 200" should match 200
pub fn status_exact_match_200_test() {
  let response = make_response(200, "ok", "GET", "/api/users")
  let rule = make_rule("test", "== 200", "GET", "/api/users")

  check_rules([rule], response, "test")
  |> should.equal([RulePassed("test")])
}

/// Test: Status "== 200" should not match 201
pub fn status_exact_match_fail_test() {
  let response = make_response(201, "created", "GET", "/api/users")
  let rule = make_rule("test", "== 200", "GET", "/api/users")

  let result = check_rules([rule], response, "test")
  case result {
    [RuleFailed(_, _, _)] -> Nil
    _ -> should.fail("Expected RuleFailed")
  }
}

/// Test: Status "200" (without ==) should match 200
pub fn status_implicit_exact_match_test() {
  let response = make_response(200, "ok", "GET", "/api/users")
  let rule = make_rule("test", "200", "GET", "/api/users")

  check_rules([rule], response, "test")
  |> should.equal([RulePassed("test")])
}

