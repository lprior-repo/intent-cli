// ============================================================================
// J. Multiple Body Checks in One Rule
// ============================================================================

/// Test: Multiple body_must_contain checks should all pass
pub fn multiple_body_must_contain_test() {
  let response = make_response(200, "user created successfully", "GET", "/api/users")
  let rule_check = RuleCheck(
    body_must_not_contain: [],
    body_must_contain: ["user", "created", "successfully"],
    fields_must_exist: [],
    fields_must_not_exist: [],
    header_must_exist: "",
    header_must_not_exist: "",
  )
  let rule = Rule(
    name: "test",
    description: "Test rule",
    when: When(status: "== 200", method: Get, path: "/api/users"),
    check: rule_check,
    example: json.null(),
  )

  check_rules([rule], response, "test")
  |> should.equal([RulePassed("test")])
}

/// Test: Multiple body_must_contain checks should fail if any missing
pub fn multiple_body_must_contain_one_missing_test() {
  let response = make_response(200, "user created", "GET", "/api/users")
  let rule_check = RuleCheck(
    body_must_not_contain: [],
    body_must_contain: ["user", "created", "successfully"],
    fields_must_exist: [],
    fields_must_not_exist: [],
    header_must_exist: "",
    header_must_not_exist: "",
  )
  let rule = Rule(
    name: "test",
    description: "Test rule",
    when: When(status: "== 200", method: Get, path: "/api/users"),
    check: rule_check,
    example: json.null(),
  )

  let result = check_rules([rule], response, "test")
  case result {
    [RuleFailed("test", _, violations)] -> {
      let has_missing = list.any(violations, fn(v) {
        case v {
          BodyMissing("successfully") -> True
          _ -> False
        }
      })
      has_missing
      |> should.equal(True)
    }
    _ -> should.fail("Expected RuleFailed")
  }
}

// ============================================================================
// K. Format Violation Tests
// ============================================================================

/// Test: format_violation for BodyContains
pub fn format_violation_body_contains_test() {
  format_violation(BodyContains("error", "response body"))
  |> should.equal("Found forbidden string 'error' in response body")
}

/// Test: format_violation for BodyMissing
pub fn format_violation_body_missing_test() {
  format_violation(BodyMissing("success"))
  |> should.equal("Required string 'success' not found in response body")
}

/// Test: format_violation for FieldMissing
pub fn format_violation_field_missing_test() {
  format_violation(FieldMissing("user.id"))
  |> should.equal("Required field 'user.id' not found")
}

/// Test: format_violation for FieldPresent
pub fn format_violation_field_present_test() {
  format_violation(FieldPresent("password"))
  |> should.equal("Forbidden field 'password' is present in response")
}

/// Test: format_violation for HeaderMissing
pub fn format_violation_header_missing_test() {
  format_violation(HeaderMissing("content-type"))
  |> should.equal("Required header 'content-type' not found")
}

/// Test: format_violation for HeaderPresent
pub fn format_violation_header_present_test() {
  format_violation(HeaderPresent("x-internal-id"))
  |> should.equal("Forbidden header 'x-internal-id' is present in response")
}

