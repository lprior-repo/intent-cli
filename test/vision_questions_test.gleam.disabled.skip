import gleam/list
import gleeunit
import gleeunit/should
import intent/question_loader
import intent/question_types.{
  Business, Constraint, Critical, HappyPath, Important, User,
}

pub fn main() -> Nil {
  gleeunit.main()
}

// ============================================================================
// Vision Questions Tests
// ============================================================================

pub fn vision_questions_load_from_cue_test() {
  let result = question_loader.load_default_questions()

  case result {
    Ok(db) -> {
      // Should have vision profile
      db.vision.round_1
      |> list.length
      |> should.equal(8)
    }
    Error(e) -> {
      question_loader.format_error(e)
      |> should.fail()
    }
  }
}

pub fn vision_round_1_has_8_questions_test() {
  case question_loader.load_default_questions() {
    Ok(db) -> {
      let questions = question_loader.get_questions(db, "vision", 1)
      list.length(questions) |> should.equal(8)
    }
    Error(_) -> should.fail()
  }
}

pub fn vision_round_2_is_empty_test() {
  case question_loader.load_default_questions() {
    Ok(db) -> {
      let questions = question_loader.get_questions(db, "vision", 2)
      list.length(questions) |> should.equal(0)
    }
    Error(_) -> should.fail()
  }
}

pub fn vision_question_1_press_release_test() {
  case question_loader.load_default_questions() {
    Ok(db) -> {
      case db.vision.round_1 {
        [q1, ..] -> {
          q1.id |> should.equal("r1-vision-1")
          q1.question |> should.equal("What problem are we solving?")
          q1.extract_into |> should.equal(["press_release"])
          q1.perspective |> should.equal(Business)
          q1.category |> should.equal(HappyPath)
          q1.priority |> should.equal(Critical)
        }
        _ -> should.fail()
      }
    }
    Error(_) -> should.fail()
  }
}

pub fn vision_question_2_persona_test() {
  case question_loader.load_default_questions() {
    Ok(db) -> {
      case db.vision.round_1 {
        [_, q2, ..] -> {
          q2.id |> should.equal("r1-vision-2")
