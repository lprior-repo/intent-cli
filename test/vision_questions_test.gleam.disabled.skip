pub fn vision_all_questions_have_context_test() {
  case question_loader.load_default_questions() {
    Ok(db) -> {
      db.vision.round_1
      |> list.each(fn(q) {
        q.context
        |> should.not_equal("")
      })
    }
    Error(_) -> should.fail()
  }
}

