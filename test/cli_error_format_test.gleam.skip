//// Tests for standardized CLI error formatting
//// Ensures consistent error message format across the CLI
////
//// Standard format:
////   Error: <message>
////
////   Usage: <hint>  (optional)
////
////   <context lines>  (optional)

import gleam/option.{None, Some}
import gleam/string
import gleeunit/should
import intent/ai_errors

// =============================================================================
// Phase 4 (RED): Failing tests for standardized CLI error format
// =============================================================================

// -----------------------------------------------------------------------------
// Basic Error Message Tests
// -----------------------------------------------------------------------------

pub fn format_cli_error_basic_message_test() {
  let error = ai_errors.cli_error("spec file path required")
  let formatted = ai_errors.format_cli_error(error)

  formatted
  |> should.equal("Error: spec file path required")
}

pub fn format_cli_error_message_with_prefix_test() {
  // Error messages should always start with "Error: "
  let error = ai_errors.cli_error("invalid session ID")
  let formatted = ai_errors.format_cli_error(error)

  string.starts_with(formatted, "Error: ")
  |> should.be_true
}

pub fn format_cli_error_preserves_message_content_test() {
  let message = "CUE validation failed for 'spec.cue'"
  let error = ai_errors.cli_error(message)
  let formatted = ai_errors.format_cli_error(error)

  string.contains(formatted, message)
  |> should.be_true
}

// -----------------------------------------------------------------------------
// Usage Hint Tests
// -----------------------------------------------------------------------------

pub fn format_cli_error_with_usage_hint_test() {
  let error =
    ai_errors.cli_error_with_usage(
      message: "spec file path required",
      usage: "intent export <spec.cue>",
    )
  let formatted = ai_errors.format_cli_error(error)

  // Should contain both error and usage
  string.contains(formatted, "Error: spec file path required")
  |> should.be_true

  string.contains(formatted, "Usage: intent export <spec.cue>")
  |> should.be_true
}

pub fn format_cli_error_usage_on_separate_line_test() {
  let error =
    ai_errors.cli_error_with_usage(
      message: "missing argument",
      usage: "intent check <spec.cue> --target=URL",
    )
  let formatted = ai_errors.format_cli_error(error)

  // Usage should be on a separate line with blank line before it
  let lines = string.split(formatted, "\n")
  let has_blank_before_usage =
    lines
    |> has_blank_line_before("Usage:")

  has_blank_before_usage
  |> should.be_true
}

// -----------------------------------------------------------------------------
// Context Tests
// -----------------------------------------------------------------------------

pub fn format_cli_error_with_single_context_test() {
  let error =
    ai_errors.cli_error_with_context(
      message: "session not found",
      context: ["Run 'intent sessions' to list available sessions"],
    )
  let formatted = ai_errors.format_cli_error(error)

  string.contains(formatted, "session not found")
  |> should.be_true

  string.contains(formatted, "Run 'intent sessions' to list available sessions")
  |> should.be_true
}

pub fn format_cli_error_with_multiple_context_lines_test() {
  let error =
    ai_errors.cli_error_with_context(
      message: "invalid profile",
      context: [
        "Valid profiles: api, cli, event, data, workflow, ui",
        "Use: intent interview --profile=api",
      ],
    )
  let formatted = ai_errors.format_cli_error(error)

  string.contains(formatted, "Valid profiles:")
  |> should.be_true

  string.contains(formatted, "Use: intent interview")
  |> should.be_true
}

// -----------------------------------------------------------------------------
// Full Format Tests (message + usage + context)
// -----------------------------------------------------------------------------

pub fn format_cli_error_full_format_test() {
  let error =
    ai_errors.CliError(
      message: "unexpected argument 'api'",
      usage_hint: Some("intent interview --profile=api"),
      context: [
        "Did you mean to use --profile flag?",
        "Valid profiles: api, cli, event, data, workflow, ui",
      ],
    )
  let formatted = ai_errors.format_cli_error(error)

  // Verify order: Error first, then Usage, then context
  let error_pos = find_position(formatted, "Error:")
  let usage_pos = find_position(formatted, "Usage:")
  let context_pos = find_position(formatted, "Did you mean")

  { error_pos < usage_pos }
  |> should.be_true

  { usage_pos < context_pos }
  |> should.be_true
}

pub fn format_cli_error_no_trailing_newlines_test() {
  let error = ai_errors.cli_error("simple error")
  let formatted = ai_errors.format_cli_error(error)

  // Should not end with newlines
  string.ends_with(formatted, "\n")
  |> should.be_false
}

// -----------------------------------------------------------------------------
// Empty Optional Fields Tests
// -----------------------------------------------------------------------------

pub fn format_cli_error_empty_context_test() {
  let error =
    ai_errors.CliError(message: "test error", usage_hint: None, context: [])
  let formatted = ai_errors.format_cli_error(error)

  // Should just be the error message
  formatted
  |> should.equal("Error: test error")
}

pub fn format_cli_error_empty_usage_with_context_test() {
  let error =
    ai_errors.CliError(
      message: "file not found",
      usage_hint: None,
      context: ["Check the file path exists"],
    )
  let formatted = ai_errors.format_cli_error(error)

  string.contains(formatted, "Error: file not found")
  |> should.be_true

  string.contains(formatted, "Check the file path exists")
  |> should.be_true

  // Should NOT contain "Usage:" since it's None
  string.contains(formatted, "Usage:")
  |> should.be_false
}

// -----------------------------------------------------------------------------
// Edge Cases
// -----------------------------------------------------------------------------

pub fn format_cli_error_multiline_message_test() {
  let error =
    ai_errors.cli_error(
      "CUE validation failed\n  spec.cue:42: undefined field 'foo'",
    )
  let formatted = ai_errors.format_cli_error(error)

  // Should preserve the multiline content
  string.contains(formatted, "spec.cue:42")
  |> should.be_true
}

pub fn format_cli_error_special_characters_test() {
  let error = ai_errors.cli_error("Expected '<spec.cue>' but got '|invalid|'")
  let formatted = ai_errors.format_cli_error(error)

  string.contains(formatted, "<spec.cue>")
  |> should.be_true

  string.contains(formatted, "|invalid|")
  |> should.be_true
}

// -----------------------------------------------------------------------------
// Integration with Existing Error Types
// -----------------------------------------------------------------------------

pub fn cli_error_from_structured_error_test() {
  // Should be able to convert StructuredError to CliError
  let structured = ai_errors.file_not_found("/path/to/spec.cue")
  let cli = ai_errors.cli_error_from_structured(structured)
  let formatted = ai_errors.format_cli_error(cli)

  string.starts_with(formatted, "Error:")
  |> should.be_true

  string.contains(formatted, "File not found")
  |> should.be_true
}

// =============================================================================
// Helper Functions
// =============================================================================

fn has_blank_line_before(lines: List(String), target: String) -> Bool {
  has_blank_line_before_loop(lines, target, False)
}

fn has_blank_line_before_loop(
  lines: List(String),
  target: String,
  prev_blank: Bool,
) -> Bool {
  case lines {
    [] -> False
    [line, ..rest] -> {
      case string.contains(line, target) {
        True -> prev_blank
        False -> {
          let is_blank = string.trim(line) == ""
          has_blank_line_before_loop(rest, target, is_blank)
        }
      }
    }
  }
}

fn find_position(text: String, needle: String) -> Int {
  case string.split(text, needle) {
    [before, ..] -> string.length(before)
    [] -> -1
  }
}
