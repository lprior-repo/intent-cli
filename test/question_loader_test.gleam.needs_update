  let q =
    Question(
      id: "q1",
      round: 1,
      perspective: User,
      category: NonFunctional,
      priority: Important,
      question: "Test",
      context: "Test",
      example: "Test",
      expected_type: "text",
      extract_into: [],
      depends_on: [],
      blocks: [],
    )
  q.category |> should.equal(NonFunctional)
}

