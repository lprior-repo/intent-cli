// ============================================================================
// Question Structure Tests
// ============================================================================

/// Test question preserves all fields correctly
pub fn question_structure_preserves_fields_test() {
  let q =
    Question(
      id: "test-id",
      round: 1,
      perspective: Developer,
      category: EdgeCase,
      priority: Critical,
      question: "Test question?",
      context: "Test context",
      example: "Test example",
      expected_type: "boolean",
      extract_into: ["var1", "var2"],
      depends_on: ["q1", "q2"],
      blocks: ["q3"],
    )

  q.id |> should.equal("test-id")
  q.round |> should.equal(1)
  q.perspective |> should.equal(Developer)
  q.category |> should.equal(EdgeCase)
  q.priority |> should.equal(Critical)
  q.question |> should.equal("Test question?")
  q.context |> should.equal("Test context")
  q.example |> should.equal("Test example")
  q.expected_type |> should.equal("boolean")
  q.extract_into |> should.equal(["var1", "var2"])
  q.depends_on |> should.equal(["q1", "q2"])
  q.blocks |> should.equal(["q3"])
}

// ============================================================================
// Custom Questions Structure Tests
// ============================================================================

/// Test CustomQuestions with all fields as None
pub fn custom_questions_all_none_test() {
  let custom =
    CustomQuestions(
      api: None,
      cli: None,
      event: None,
      data: None,
      workflow: None,
      ui: None,
      common: None,
    )

  custom.api |> should.equal(None)
  custom.cli |> should.equal(None)
}

/// Test CustomQuestions with some fields as Some
pub fn custom_questions_some_fields_test() {
  let custom_api =
    CustomProfileQuestions(
      round_1: None,
      round_2: Some([test_question("custom-q1", 2, User)]),
    )
  let custom =
    CustomQuestions(
      api: Some(custom_api),
      cli: None,
      event: None,
      data: None,
      workflow: None,
      ui: None,
      common: None,
    )

  case custom.api {
    Some(cp) -> {
      cp.round_1 |> should.equal(None)
      case cp.round_2 {
        Some(questions) -> questions |> list.length |> should.equal(1)
        None -> should.fail("Expected Some questions")
      }
    }
    None -> should.fail("Expected Some custom api")
  }
}

/// Test CustomCommonQuestions structure
pub fn custom_common_questions_structure_test() {
  let q1 = test_question("custom-common-1", 3, Security)
  let custom_common =
    CustomCommonQuestions(round_3: Some([q1]), round_4: None, round_5: None)

  case custom_common.round_3 {
    Some(questions) -> questions |> list.length |> should.equal(1)
    None -> should.fail("Expected Some questions")
  }
}

// ============================================================================
// Database Structure Tests
// ============================================================================

/// Test QuestionsDatabase structure with all profiles
pub fn questions_database_structure_test() {
  let q1 = test_question("api-q1", 1, User)
  let empty = []
  let db =
    database_with(
      profile_questions_with([q1], empty),
      profile_questions_with(empty, empty),
      profile_questions_with(empty, empty),
      profile_questions_with(empty, empty),
      profile_questions_with(empty, empty),
      profile_questions_with(empty, empty),
      common_questions_with(empty, empty, empty),
    )

  db.api.round_1 |> list.length |> should.equal(1)
  db.cli.round_1 |> list.length |> should.equal(0)
  db.event.round_1 |> list.length |> should.equal(0)
  db.data.round_1 |> list.length |> should.equal(0)
  db.workflow.round_1 |> list.length |> should.equal(0)
  db.ui.round_1 |> list.length |> should.equal(0)
}

