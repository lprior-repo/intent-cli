//// Comprehensive tests for question_loader module
//// Tests JSON parsing, question merging, perspective/category/priority parsing,
//// and error handling for question database operations

import gleam/dynamic
import gleam/list
import gleam/option.{None, Some}
import gleeunit
import gleeunit/should
import intent/question_loader.{
  type CommonQuestions, type CustomCommonQuestions, type CustomProfileQuestions,
  type CustomQuestions, type ProfileQuestions, type QuestionLoadError,
  type QuestionsDatabase, CommonQuestions, CueExportError, CustomCommonQuestions,
  CustomProfileQuestions, CustomQuestions, FileNotFound, JsonParseError,
  ProfileQuestions, QuestionParseError, QuestionsDatabase, SecurityError,
  format_error, get_questions,
}
import intent/question_types.{
  type Perspective, type Question, type QuestionCategory, type QuestionPriority,
  Business, Constraint, Critical, Developer, EdgeCase, ErrorCase, HappyPath,
  Important, NiceTohave, NonFunctional, Ops, Question, Security, User,
}

pub fn main() {
  gleeunit.main()
}

// ============================================================================
// Helper Functions
// ============================================================================

/// Helper to create a test question with sensible defaults
fn test_question(id: String, round: Int, perspective: Perspective) -> Question {
  Question(
    id: id,
    round: round,
    perspective: perspective,
    category: HappyPath,
    priority: Important,
    question: "What is the behavior of " <> id <> "?",
    context: "Testing context for " <> id,
    example: "Example for " <> id,
    expected_type: "text",
    extract_into: [],
    depends_on: [],
    blocks: [],
  )
}

/// Helper to create a profile questions structure
fn profile_questions_with(
  round_1: List(Question),
  round_2: List(Question),
) -> ProfileQuestions {
  ProfileQuestions(round_1: round_1, round_2: round_2)
}

/// Helper to create a common questions structure
fn common_questions_with(
  round_3: List(Question),
  round_4: List(Question),
  round_5: List(Question),
) -> CommonQuestions {
  CommonQuestions(round_3: round_3, round_4: round_4, round_5: round_5)
}

/// Helper to create a questions database with default empty questions
fn database_with(
  api: ProfileQuestions,
  cli: ProfileQuestions,
  event: ProfileQuestions,
  data: ProfileQuestions,
  workflow: ProfileQuestions,
  ui: ProfileQuestions,
  common: CommonQuestions,
) -> QuestionsDatabase {
  QuestionsDatabase(
    api: api,
    cli: cli,
    event: event,
    data: data,
    workflow: workflow,
    ui: ui,
    common: common,
  )
}

// ============================================================================
// format_error Tests
// ============================================================================

/// Test FileNotFound error formatting
pub fn format_error_file_not_found_test() {
  let error = FileNotFound("schema/questions.cue")
  let result = format_error(error)
  result
  |> should.equal("Questions file not found: schema/questions.cue")
}

/// Test CueExportError error formatting with message
pub fn format_error_cue_export_test() {
  let error = CueExportError("cue: error evaluating: undefined expression")
  let result = format_error(error)
  result
  |> should.start_with("CUE export failed:\n")
}

/// Test JsonParseError error formatting
pub fn format_error_json_parse_test() {
  let error = JsonParseError("Unexpected token at position 42")
  let result = format_error(error)
  result
  |> should.equal("JSON parse error: Unexpected token at position 42")
}

/// Test QuestionParseError error formatting
pub fn format_error_question_parse_test() {
  let error = QuestionParseError("Missing required field: id")
  let result = format_error(error)
  result
  |> should.equal("Question parse error: Missing required field: id")
}

/// Test SecurityError error formatting
pub fn format_error_security_error_test() {
  let error = SecurityError("Path traversal detected")
  let result = format_error(error)
  result
  |> should.equal("Path traversal detected")
}

// ============================================================================
// get_questions Tests - Profile Rounds
// ============================================================================

/// Test get_questions returns API profile round 1
pub fn get_questions_api_round_1_test() {
  let q1 = test_question("api-q1", 1, User)
  let q2 = test_question("api-q2", 1, Developer)
  let empty_questions = []
  let db =
    database_with(
      profile_questions_with([q1, q2], empty_questions),
      profile_questions_with(empty_questions, empty_questions),
      profile_questions_with(empty_questions, empty_questions),
      profile_questions_with(empty_questions, empty_questions),
      profile_questions_with(empty_questions, empty_questions),
      profile_questions_with(empty_questions, empty_questions),
      common_questions_with(empty_questions, empty_questions, empty_questions),
    )

  let result = get_questions(db, "api", 1)
  result
  |> list.length
  |> should.equal(2)
  result
  |> list.map(fn(q) { q.id })
  |> should.equal(["api-q1", "api-q2"])
}

/// Test get_questions returns API profile round 2
pub fn get_questions_api_round_2_test() {
  let q1 = test_question("api-r2-q1", 2, User)
  let empty_questions = []
  let db =
    database_with(
      profile_questions_with(empty_questions, [q1]),
      profile_questions_with(empty_questions, empty_questions),
      profile_questions_with(empty_questions, empty_questions),
      profile_questions_with(empty_questions, empty_questions),
      profile_questions_with(empty_questions, empty_questions),
      profile_questions_with(empty_questions, empty_questions),
      common_questions_with(empty_questions, empty_questions, empty_questions),
    )

  let result = get_questions(db, "api", 2)
  result
  |> list.length
  |> should.equal(1)
  result
  |> list.map(fn(q) { q.id })
  |> should.equal(["api-r2-q1"])
}

