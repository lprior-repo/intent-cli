// ============================================================================
// Optional Fields Tests
// ============================================================================

/// Test question with optional fields populated
pub fn question_optional_fields_populated_test() {
  let q =
    Question(
      id: "q1",
      round: 1,
      perspective: User,
      category: HappyPath,
      priority: Important,
      question: "Test",
      context: "Test",
      example: "Test",
      expected_type: "string",
      extract_into: ["var1", "var2"],
      depends_on: ["q0"],
      blocks: ["q2"],
    )

  q.expected_type |> should.equal("string")
  q.extract_into |> list.length |> should.equal(2)
  q.depends_on |> list.length |> should.equal(1)
  q.blocks |> list.length |> should.equal(1)
}

/// Test question with optional fields empty
pub fn question_optional_fields_empty_test() {
  let q =
    Question(
      id: "q1",
      round: 1,
      perspective: User,
      category: HappyPath,
      priority: Important,
      question: "Test",
      context: "Test",
      example: "Test",
      expected_type: "text",
      extract_into: [],
      depends_on: [],
      blocks: [],
    )

  q.expected_type |> should.equal("text")
  q.extract_into |> list.length |> should.equal(0)
  q.depends_on |> list.length |> should.equal(0)
  q.blocks |> list.length |> should.equal(0)
}

// ============================================================================
// Multiple Questions Tests
// ============================================================================

/// Test database with multiple questions in single profile
pub fn multiple_questions_single_profile_test() {
  let q1 = test_question("q1", 1, User)
  let q2 = test_question("q2", 1, Developer)
  let q3 = test_question("q3", 1, Ops)
  let empty = []
  let db =
    database_with(
      profile_questions_with([q1, q2, q3], empty),
      profile_questions_with(empty, empty),
      profile_questions_with(empty, empty),
      profile_questions_with(empty, empty),
      profile_questions_with(empty, empty),
      profile_questions_with(empty, empty),
      common_questions_with(empty, empty, empty),
    )

  let result = get_questions(db, "api", 1)
  result |> list.length |> should.equal(3)
}

/// Test database with questions across multiple profiles
pub fn multiple_questions_multiple_profiles_test() {
  let q1 = test_question("api-q1", 1, User)
  let q2 = test_question("cli-q1", 1, Developer)
  let q3 = test_question("event-q1", 1, Ops)
  let empty = []
  let db =
    database_with(
      profile_questions_with([q1], empty),
      profile_questions_with([q2], empty),
      profile_questions_with([q3], empty),
      profile_questions_with(empty, empty),
      profile_questions_with(empty, empty),
      profile_questions_with(empty, empty),
      common_questions_with(empty, empty, empty),
    )

  get_questions(db, "api", 1) |> list.length |> should.equal(1)
  get_questions(db, "cli", 1) |> list.length |> should.equal(1)
  get_questions(db, "event", 1) |> list.length |> should.equal(1)
}

// ============================================================================
// List Operations Tests
// ============================================================================

/// Test filtering questions from list
pub fn filter_questions_from_list_test() {
  let q1 = test_question("q1", 1, User)
  let q2 = test_question("q2", 1, Developer)
  let q3 = test_question("q3", 1, Ops)
  let questions = [q1, q2, q3]

  let filtered = list.filter(questions, fn(q) { q.perspective != User })

  filtered |> list.length |> should.equal(2)
}

/// Test mapping over questions
pub fn map_questions_from_list_test() {
  let q1 = test_question("q1", 1, User)
  let q2 = test_question("q2", 1, Developer)
  let questions = [q1, q2]

  let ids = list.map(questions, fn(q) { q.id })

  ids |> list.length |> should.equal(2)
  ids |> should.equal(["q1", "q2"])
}

/// Test appending question lists
pub fn append_question_lists_test() {
  let q1 = test_question("q1", 1, User)
  let q2 = test_question("q2", 1, Developer)
  let list1 = [q1]
  let list2 = [q2]

  let combined = list.append(list1, list2)

  combined |> list.length |> should.equal(2)
}
