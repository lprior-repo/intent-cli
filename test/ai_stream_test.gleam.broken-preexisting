//// Tests for intent ai stream command
//// Phase 4 (RED) -> Phase 5 (GREEN): Tests for streaming JSONL command
//// TDD15 bead: intent-cli-eu9

import gleeunit/should
import intent/stream_processor

// =============================================================================
// stream_processor Tests
// =============================================================================

/// Test: process_stream handles single line input
pub fn process_stream_single_line_test() {
  let input = "{\"command\":\"quality\",\"args\":{\"spec_path\":\"test.cue\"}}"
  let output = stream_processor.process_stream(input)

  // Should contain one response line
  output |> should.not_equal("")
  output |> should.contain("\"success\"")
  output |> should.contain("\"command\"")
}

/// Test: process_stream handles multiple lines
pub fn process_stream_multiple_lines_test() {
  let input =
    "{\"command\":\"quality\",\"args\":{\"spec_path\":\"test.cue\"}}\n{\"command\":\"coverage\",\"args\":{\"spec_path\":\"test.cue\"}}"
  let output = stream_processor.process_stream(input)

  // Should contain two response lines
  let lines = output |> string.split("\n") |> list.filter(fn(l) { l != "" })
  list.length(lines) |> should.equal(2)
}

/// Test: process_stream handles empty input
pub fn process_stream_empty_input_test() {
  let input = ""
  let output = stream_processor.process_stream(input)

  // Should return empty output for empty input
  output |> should.equal("")
}

/// Test: process_stream handles blank lines
pub fn process_stream_blank_lines_test() {
  let input = "\n\n{\"command\":\"quality\",\"args\":{}}\n\n"
  let output = stream_processor.process_stream(input)

  // Should produce only one response (blank lines ignored)
  let lines = output |> string.split("\n") |> list.filter(fn(l) { l != "" })
  list.length(lines) |> should.equal(1)
}

/// Test: process_stream handles invalid JSON gracefully
pub fn process_stream_invalid_json_test() {
  let input = "{invalid json}"
  let output = stream_processor.process_stream(input)

  // Should return error response as JSONL
  output |> should.contain("\"success\":false")
  output |> should.contain("INVALID_JSON")
}

/// Test: process_stream handles mixed valid and invalid input
pub fn process_stream_mixed_input_test() {
  let input =
    "{\"command\":\"quality\",\"args\":{}}\n{bad json}\n{\"command\":\"coverage\",\"args\":{}}"
  let output = stream_processor.process_stream(input)

  // Should produce three responses (2 success, 1 error)
  let lines = output |> string.split("\n") |> list.filter(fn(l) { l != "" })
  list.length(lines) |> should.equal(3)
}

/// Test: process_line processes single JSONL line
pub fn process_line_valid_test() {
  let line = "{\"command\":\"quality\",\"args\":{\"spec_path\":\"test.cue\"}}"
  let response = stream_processor.process_line(line)

  response |> should.not_equal("")
  response |> should.contain("\"success\"")
}

/// Test: process_line returns error for invalid JSON
pub fn process_line_invalid_json_test() {
  let line = "{bad"
  let response = stream_processor.process_line(line)

  response |> should.contain("\"success\":false")
  response |> should.contain("INVALID_JSON")
}

/// Test: process_line ignores empty line
pub fn process_line_empty_test() {
  let line = ""
  let response = stream_processor.process_line(line)

  // Empty lines should return empty response
  response |> should.equal("")
}

/// Test: process_line ignores whitespace-only line
pub fn process_line_whitespace_test() {
  let line = "   \t  "
  let response = stream_processor.process_line(line)

  // Whitespace-only lines should return empty response
  response |> should.equal("")
}

