/// Test format_report includes score section
pub fn format_report_includes_score_section_test() {
  let behavior = make_behavior("test", "test", 200, "", True, [])
  let spec = make_spec([make_feature("F", [behavior])], [])
  let report = quality_analyzer.analyze_spec(spec)

  let formatted = quality_analyzer.format_report(report)

  string.contains(formatted, "Quality Score:")
  |> should.equal(True)

  string.contains(formatted, "Coverage:")
  |> should.equal(True)

  string.contains(formatted, "Clarity:")
  |> should.equal(True)

  string.contains(formatted, "Testability:")
  |> should.equal(True)

  string.contains(formatted, "AI Readiness:")
  |> should.equal(True)
}

/// Test format_report shows no issues when empty
pub fn format_report_shows_no_issues_when_empty_test() {
  let behavior = make_behavior("test", "test", 200, "", True, [
    #("check", "status is 200", "Successful"),
  ])
  let behavior_with_auth = make_behavior("auth", "auth", 200, "notes", True, [
    #("check", "status is 200", "Successful"),
  ])
  let behavior_with_edge = make_behavior("empty", "edge", 200, "notes", True, [
    #("check", "status is 200", "Successful"),
  ])
  let error_behavior = make_behavior("error", "error", 404, "notes", True, [
    #("check", "status is 404", "Error case"),
  ])

  let spec = make_spec(
    [
      make_feature("F", [
        behavior,
        behavior_with_auth,
        behavior_with_edge,
        error_behavior,
      ]),
    ],
    [],
  )
  let report = quality_analyzer.analyze_spec(spec)

  let formatted = quality_analyzer.format_report(report)

  // If issues is empty, should contain "No quality issues found!"
  case list.is_empty(report.issues) {
    True -> {
      string.contains(formatted, "No quality issues found!")
      |> should.equal(True)
    }
    False -> {
      string.contains(formatted, "Quality Issues:")
      |> should.equal(True)
    }
  }
}

/// Test format_report includes suggestions section
pub fn format_report_includes_suggestions_section_test() {
  let behavior = make_behavior("test", "test", 200, "", False, [])
  let spec = make_spec([make_feature("F", [behavior])], [])
  let report = quality_analyzer.analyze_spec(spec)

  let formatted = quality_analyzer.format_report(report)

  // If there are suggestions, should include numbered list
  case list.is_empty(report.suggestions) {
    False -> {
      string.contains(formatted, "Suggestions for Improvement:")
      |> should.equal(True)

      string.contains(formatted, "1. ")
      |> should.equal(True)
    }
    True -> {
      // No suggestions, so section should not exist
      Nil
    }
  }
}

/// Test format_report with multiple issues
pub fn format_report_with_multiple_issues_test() {
  let behavior = make_behavior("test", "test", 200, "", False, [])
  let spec = make_spec([make_feature("F", [behavior])], [])
  let report = quality_analyzer.analyze_spec(spec)

  let formatted = quality_analyzer.format_report(report)

  // Should have multiple issues listed
  (list.length(report.issues) > 0)
  |> should.be_true

  string.contains(formatted, "•")
  |> should.equal(True)
}

/// Test high quality spec with all best practices
pub fn high_quality_spec_achieves_high_score_test() {
  let behavior1 = make_behavior("list_users", "retrieve all users", 200, "Returns paginated list", True, [
    #("status", "status is 200", "Successful response"),
    #("count", "response.users length > 0", "Should return at least one user"),
  ])

  let behavior2 = make_behavior("auth_login", "authenticate with credentials", 200, "Returns JWT token", True, [
    #("token", "response.token exists", "JWT token is present"),
  ])

  let behavior3 = make_behavior("user_not_found", "handle missing user", 404, "Returns 404 error", True, [
    #("error", "response.error exists", "Error message is provided"),
  ])

  let behavior4 = make_behavior("invalid_input", "edge case with empty username", 400, "Returns validation error", True, [
    #("error", "response.error exists", "Error message is provided"),
  ])

  let spec = types.Spec(
    name: "High Quality API",
    description: "Well-documented API spec",
    audience: "Developers",
    version: "1.0.0",
    success_criteria: ["All endpoints return appropriate status codes"],
    config: types.Config(
      base_url: "http://api.example.com",
      timeout_ms: 5000,
      headers: dict.from_list([#("Content-Type", "application/json")]),
    ),
    features: [
      make_feature("Authentication", [behavior2]),
      make_feature("Users", [behavior1, behavior3, behavior4]),
    ],
    rules: [],
    anti_patterns: [],
    ai_hints: types.AIHints(
      implementation: types.ImplementationHints(
        suggested_stack: ["Node.js", "Express", "PostgreSQL"],
      ),
      entities: dict.new(),
      security: types.SecurityHints(
        password_hashing: "bcrypt",
        jwt_algorithm: "HS256",
        jwt_expiry: "24h",
        rate_limiting: "100/min",
      ),
      pitfalls: ["Never store passwords in plain text"],
    ),
  )

  let report = quality_analyzer.analyze_spec(spec)

  // High quality spec should have overall score > 70
  (report.overall_score > 70)
  |> should.be_true

  // Should have few or no issues
  (list.length(report.issues) <= 2)
  |> should.be_true
}

/// Test low quality spec identifies multiple issues
pub fn low_quality_spec_identifies_issues_test() {
  let behavior = make_behavior("test", "", 200, "", False, [
    #("check", "valid", ""),
  ])

  let spec = make_spec([make_feature("F", [behavior])], [])
  let report = quality_analyzer.analyze_spec(spec)

  // Low quality spec should have many issues
  (list.length(report.issues) > 3)
  |> should.be_true

  // Overall score should be moderate
  (report.overall_score < 70)
  |> should.be_true
}

/// Test all scores stay within bounds
pub fn all_scores_stay_within_bounds_test() {
  let behaviors =
    list.range(1, 20)
    |> list.map(fn(i) {
      let has_example = i % 2 == 0
      let status = case i % 5 {
        0 -> 404
        1 -> 401
        _ -> 200
      }
      let intent = case i % 3 {
        0 -> ""
        _ -> "Intent " <> int.to_string(i)
      }
      make_behavior(
        "behavior_" <> int.to_string(i),
        intent,
        status,
        "Note",
        has_example,
        [#("check", "rule", "why")],
      )
    })

  let features = [make_feature("Feature", behaviors)]
  let spec = make_spec(features, [])

  let report = quality_analyzer.analyze_spec(spec)

  // All scores must be 0-100
  (report.coverage_score >= 0 && report.coverage_score <= 100)
  |> should.be_true

  (report.clarity_score >= 0 && report.clarity_score <= 100)
  |> should.be_true

  (report.testability_score >= 0 && report.testability_score <= 100)
  |> should.be_true

  (report.ai_readiness_score >= 0 && report.ai_readiness_score <= 100)
  |> should.be_true

  (report.overall_score >= 0 && report.overall_score <= 100)
  |> should.be_true
}

/// Test empty spec handling
pub fn empty_spec_handles_no_behaviors_test() {
  let spec = make_spec([], [])

  let report = quality_analyzer.analyze_spec(spec)

  // Should not crash and return valid report
  (report.overall_score >= 0 && report.overall_score <= 100)
  |> should.be_true
}
