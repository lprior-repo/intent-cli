pub fn coverage_score_includes_auth_bonus_test() {
  let success_behavior = make_behavior("get", "retrieve data", 200, "", True, [])
  let auth_behavior = make_behavior("auth", "authenticate user", 200, "", True, [])

  let spec_no_auth = make_spec([make_feature("F", [success_behavior])], [])
