/// Comprehensive tests for quality_analyzer.gleam
/// Tests all scoring functions, issue detection, and report formatting

import gleam/dict
import gleam/int
import gleam/json
import gleam/list
import gleam/string
import gleeunit/should
import intent/quality_analyzer
import intent/types

/// Helper to create a minimal test behavior
fn make_behavior(
  name: String,
  intent: String,
  status: Int,
  notes: String,
  has_example: Bool,
  checks: List(#(String, String, String)),
) -> types.Behavior {
  let checks_dict = dict.from_list(
    list.map(checks, fn(c) {
      let #(key, rule, why) = c
      #(key, types.Check(rule: rule, why: why))
    }),
  )

  let example = case has_example {
    True -> json.object([#("result", json.string("ok"))])
    False -> json.null()
  }

  types.Behavior(
    name: name,
    intent: intent,
    notes: notes,
    requires: [],
    tags: [],
    request: types.Request(
      method: types.Get,
      path: "/test",
      headers: dict.new(),
      query: dict.new(),
      body: json.null(),
    ),
    response: types.Response(
      status: status,
      example: example,
      checks: checks_dict,
      headers: dict.new(),
    ),
    captures: dict.new(),
  )
}

/// Helper to create a minimal test feature
fn make_feature(name: String, behaviors: List(types.Behavior)) -> types.Feature {
  types.Feature(name: name, description: "Test feature", behaviors: behaviors)
}

/// Helper to create a minimal test spec
fn make_spec(features: List(types.Feature), rules: List(types.Rule)) -> types.Spec {
  types.Spec(
    name: "Test Spec",
    description: "Test",
    audience: "Test",
    version: "1.0.0",
    success_criteria: [],
    config: types.Config(
      base_url: "http://localhost",
      timeout_ms: 5000,
      headers: dict.new(),
    ),
    features: features,
    rules: rules,
    anti_patterns: [],
    ai_hints: types.AIHints(
      implementation: types.ImplementationHints(suggested_stack: []),
      entities: dict.new(),
      security: types.SecurityHints(
        password_hashing: "bcrypt",
        jwt_algorithm: "HS256",
        jwt_expiry: "24h",
        rate_limiting: "100/min",
      ),
      pitfalls: [],
    ),
  )
}

/// Test analyze_spec returns all required fields
pub fn analyze_spec_returns_quality_report_test() {
  let behavior = make_behavior("test", "test intent", 200, "notes", True, [])
  let feature = make_feature("Feature 1", [behavior])
  let spec = make_spec([feature], [])

  let report = quality_analyzer.analyze_spec(spec)

  // All fields must be present and valid structure
  let assert quality_analyzer.QualityReport(
    coverage_score: cs,
    clarity_score: c_score,
    testability_score: ts,
    ai_readiness_score: ars,
    overall_score: os,
    issues: _,
    suggestions: _,
  ) = report

  // All scores should be between 0 and 100
  (cs >= 0 && cs <= 100) |> should.be_true
  (c_score >= 0 && c_score <= 100) |> should.be_true
  (ts >= 0 && ts <= 100) |> should.be_true
  (ars >= 0 && ars <= 100) |> should.be_true
  (os >= 0 && os <= 100) |> should.be_true
}

/// Test coverage score increases with error test cases
pub fn coverage_score_increases_with_error_statuses_test() {
  let success_behavior = make_behavior("get", "retrieve data", 200, "", True, [])
  let error_behavior = make_behavior("not found", "error case", 404, "", True, [])

  let spec_no_errors = make_spec([make_feature("F", [success_behavior])], [])
  let spec_with_errors = make_spec(
    [make_feature("F", [success_behavior, error_behavior])],
    [],
  )

  let report_no_errors = quality_analyzer.analyze_spec(spec_no_errors)
  let report_with_errors = quality_analyzer.analyze_spec(spec_with_errors)

  (report_with_errors.coverage_score > report_no_errors.coverage_score)
  |> should.be_true
}

