/// Test overall score is average of all scores
pub fn overall_score_is_average_of_subscores_test() {
  let behavior = make_behavior("test", "test", 200, "", True, [])
  let spec = make_spec([make_feature("F", [behavior])], [])

  let report = quality_analyzer.analyze_spec(spec)

  let sum = report.coverage_score
    +. report.clarity_score
    +. report.testability_score
    +. report.ai_readiness_score
  let expected_average = sum /. 4.0

  report.overall_score
  |> should.equal(expected_average)
}

