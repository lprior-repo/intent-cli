/// Test untested rules issue is detected
pub fn detects_untested_rules_issue_test() {
  let behavior = make_behavior("test", "test", 200, "", True, [])
  let rule = types.Rule(
    name: "rule1",
    description: "test rule",
    when: types.When(status: "200", method: types.Get, path: "/"),
    check: types.RuleCheck(
      body_must_not_contain: [],
      body_must_contain: [],
      fields_must_exist: [],
      fields_must_not_exist: [],
      header_must_exist: "",
      header_must_not_exist: "",
    ),
    example: json.null(),
  )
  let spec = make_spec([make_feature("F", [behavior])], [rule])

  let report = quality_analyzer.analyze_spec(spec)

  list.contains(report.issues, quality_analyzer.UntestedRules)
  |> should.equal(True)
}

