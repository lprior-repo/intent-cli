/// Test AI readiness score with hints
pub fn ai_readiness_score_includes_hints_bonus_test() {
  let no_hints = make_spec([make_feature("F", [make_behavior("test", "test", 200, "", True, [])])], [])

  let with_hints = types.Spec(
    ..no_hints,
    ai_hints: types.AIHints(
      implementation: types.ImplementationHints(
        suggested_stack: ["Node.js", "Express"],
      ),
      entities: dict.new(),
      security: types.SecurityHints(
        password_hashing: "bcrypt",
        jwt_algorithm: "HS256",
        jwt_expiry: "24h",
        rate_limiting: "100/min",
      ),
      pitfalls: [],
    ),
  )

  let report_no_hints = quality_analyzer.analyze_spec(no_hints)
  let report_with_hints = quality_analyzer.analyze_spec(with_hints)

  (report_with_hints.ai_readiness_score > report_no_hints.ai_readiness_score)
  |> should.be_true
}

/// Test AI readiness score with why explanations
pub fn ai_readiness_score_includes_why_bonus_test() {
