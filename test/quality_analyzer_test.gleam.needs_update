/// Test clarity score penalizes vague rules
pub fn clarity_score_penalizes_vague_rules_test() {
  let vague_check =
    make_behavior("test", "intent", 200, "", True, [
      #("check", "valid data", "must be valid"),
    ])

  let specific_check =
    make_behavior("test", "intent", 200, "", True, [
      #("check", "email is valid email format", "must be valid email"),
    ])

  let spec_vague = make_spec([make_feature("F", [vague_check])], [])
  let spec_specific = make_spec([make_feature("F", [specific_check])], [])

  let report_vague = quality_analyzer.analyze_spec(spec_vague)
  let report_specific = quality_analyzer.analyze_spec(spec_specific)

  (report_vague.clarity_score <= report_specific.clarity_score)
  |> should.be_true
}

/// Test testability score increases with captures
pub fn testability_score_increases_with_captures_test() {
  let no_captures = types.Behavior(
    name: "test",
    intent: "test",
    notes: "",
    requires: [],
    tags: [],
    request: types.Request(
      method: types.Get,
      path: "/test",
      headers: dict.new(),
      query: dict.new(),
      body: json.null(),
    ),
    response: types.Response(
      status: 200,
      example: json.null(),
      checks: dict.new(),
      headers: dict.new(),
    ),
    captures: dict.new(),
  )

  let with_captures = types.Behavior(
    ..no_captures,
    captures: dict.from_list([#("user_id", "123")]),
  )

  let spec_no_captures = make_spec([make_feature("F", [no_captures])], [])
  let spec_with_captures = make_spec([make_feature("F", [with_captures])], [])

  let report_no_captures = quality_analyzer.analyze_spec(spec_no_captures)
  let report_with_captures = quality_analyzer.analyze_spec(spec_with_captures)

  (report_with_captures.testability_score >= report_no_captures.testability_score)
  |> should.be_true
}

