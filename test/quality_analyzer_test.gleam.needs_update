    [make_feature("F", [success_behavior, auth_behavior])],
    [],
  )

  let report_no_auth = quality_analyzer.analyze_spec(spec_no_auth)
  let report_with_auth = quality_analyzer.analyze_spec(spec_with_auth)

  (report_with_auth.coverage_score >= report_no_auth.coverage_score)
  |> should.be_true
}

