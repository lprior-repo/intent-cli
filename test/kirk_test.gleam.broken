import gleam/result
import gleeunit
import gleeunit/should
import intent/kirk/coverage_analyzer
import intent/kirk/inversion_checker
import intent/kirk/quality_analyzer
import intent/loader

pub fn main() {
  gleeunit.main()
}

pub fn quality_analyzer_analyze_happy_path_test() {
  let spec =
    loader.load_spec("examples/pokemon-api.cue")
    |> result.unwrap("Should load spec")

  let report = quality_analyzer.analyze_quality(spec)

  report |> should.be_ok()
}

pub fn quality_analyzer_analyze_complex_spec_test() {
  let spec =
    loader.load_spec("examples/conflicts-gaps.cue")
    |> result.unwrap("Should load spec")

  let report = quality_analyzer.analyze_quality(spec)

  report |> should.be_ok()
}

pub fn quality_analyzer_analyze_empty_spec_test() {
  let spec =
    loader.load_spec("examples/array-validation.cue")
    |> result.unwrap("Should load spec")

  let report = quality_analyzer.analyze_quality(spec)

  report |> should.be_ok()
}

pub fn quality_analyzer_format_report_test() {
  let spec =
    loader.load_spec("examples/pokemon-api.cue")
    |> result.unwrap("Should load spec")

  let report =
    quality_analyzer.analyze_quality(spec)
    |> result.unwrap("Should analyze quality")

  let formatted = quality_analyzer.format_report(report)

  formatted |> string.contains("Completeness") |> should.be_true()
  formatted |> string.contains("Consistency") |> should.be_true()
  formatted |> string.contains("Testability") |> should.be_true()
}

pub fn coverage_analyzer_analyze_happy_path_test() {
  let spec =
    loader.load_spec("examples/pokemon-api.cue")
    |> result.unwrap("Should load spec")

  let coverage = coverage_analyzer.analyze_coverage(spec)

  coverage |> should.be_ok()
}

pub fn coverage_analyzer_analyze_complex_spec_test() {
  let spec =
    loader.load_spec("examples/conflicts-gaps.cue")
    |> result.unwrap("Should load spec")

  let coverage = coverage_analyzer.analyze_coverage(spec)

  coverage |> should.be_ok()
}

pub fn inversion_checker_detect_missing_cases_test() {
  let spec =
    loader.load_spec("examples/pokemon-api.cue")
    |> result.unwrap("Should load spec")

  let analysis = inversion_checker.analyze_inversion(spec)

  analysis |> should.be_ok()
}

pub fn inversion_checker_analyze_complex_spec_test() {
  let spec =
    loader.load_spec("examples/conflicts-gaps.cue")
    |> result.unwrap("Should load spec")

  let analysis = inversion_checker.analyze_inversion(spec)

  analysis |> should.be_ok()
}

pub fn kirk_quality_command_integration_test() {
  let spec =
    loader.load_spec("examples/pokemon-api.cue")
    |> result.unwrap("Should load spec")

  let report =
    kirk_quality.analyze_quality(spec)
    |> result.unwrap("Should analyze quality")

  report.completeness_score
  |> should.be_between(0.0, 1.0)
}

pub fn kirk_coverage_command_integration_test() {
  let spec =
    loader.load_spec("examples/pokemon-api.cue")
    |> result.unwrap("Should load spec")

  let coverage =
    coverage_analyzer.analyze_coverage(spec)
    |> result.unwrap("Should analyze coverage")

  coverage.total_behaviors
  |> should.be_greater_than(0)
}

pub fn kirk_invert_command_integration_test() {
  let spec =
    loader.load_spec("examples/pokemon-api.cue")
    |> result.unwrap("Should load spec")

  let analysis =
    inversion_checker.analyze_inversion(spec)
    |> result.unwrap("Should analyze inversion")

  analysis.missing_cases
  |> should.be_a(list.List)
}
