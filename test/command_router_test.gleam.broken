/// Tests for JSONL command router
import gleam/dynamic
import gleam/json
import gleam/string
import gleeunit
import gleeunit/should
import intent/command_router

pub fn main() {
  gleeunit.main()
}

// ============================================================================
// Routing Tests - These WILL FAIL until commands are implemented
// ============================================================================

pub fn route_validate_command_test() {
  let args_json = json.object([#("spec_path", json.string("api.cue"))])
  let args_dyn = dynamic.from(args_json)

  let request =
    command_router.CommandRequest(
      id: "test-1",
      command: "validate",
      args: args_dyn,
    )

  let response = command_router.route_request(request)

  // This will fail because validate isn't implemented in router yet
  response.action
  |> should.equal("validate_result")
}

