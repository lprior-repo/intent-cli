pub fn route_unknown_command_test() {
  let args_json = json.object([])
  let args_dyn = dynamic.from(args_json)

  let request =
    command_router.CommandRequest(
      id: "test-unknown",
      command: "nonexistent",
      args: args_dyn,
    )

  let response = command_router.route_request(request)

  // Should return error for unknown command
  response.success
  |> should.be_false
}

pub fn process_single_request_valid_quality_test() {
  let jsonl = "{\"command\":\"quality\",\"args\":{\"spec_path\":\"api.cue\"}}"

  let response_str = command_router.process_single_request(jsonl)

  // This should work since quality is already implemented
  should.not_equal(response_str, "")
}

pub fn process_single_request_invalid_json_test() {
  let invalid_jsonl = "{invalid json"

  let response_str = command_router.process_single_request(invalid_jsonl)

  // Should return error response
  should.not_equal(response_str, "")
  // Response should contain error
  let has_error =
    string.contains(response_str, "error")
    || string.contains(response_str, "INVALID_JSON")
  should.be_true(has_error)
}
