import gleam/dict
import gleam/json
import gleam/list
import gleam/result
import gleam/string
import gleeunit/should
import intent/parser
import intent/types

// ============================================================================
// CUE Parser Stress Test Suite
//
// This comprehensive test suite validates the parser's resilience against:
// 1. Deeply nested structures
// 2. Complex expressions
// 3. Imports and references
// 4. Invalid syntax
// 5. Large files
// 6. Edge cases and corner cases
// ============================================================================

pub fn main() -> Nil {
  gleeunit.main()
}

// Test 1: Deeply Nested CUE Structures
fn test_deeply_nested_structures() {
  // Test 100 levels of nesting
  let deep_data = create_deeply_nested_json(100)
  let result = parser.parse_spec(deep_data)

  case result {
    Ok(_) -> should.fail("Parser should fail with deeply nested structures")
    Error(_) -> should.be_true(True) // Expected failure
  }
}

fn create_deeply_nested_json(depth: Int) -> dynamic.Dynamic {
  let create_level = fn(current_depth: Int) -> dynamic.Dynamic {
    if current_depth <= 0 {
      json.object([#("value", json.string("deep"))])
    } else {
      json.object([#(
        "level_" <> string.from_int(current_depth),
        create_level(current_depth - 1),
      )])
    }
  }

  create_level(depth)
}

