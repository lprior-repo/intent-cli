    #("config", json.object([
      #("base_url", json.string("http://example.com")),
      #("timeout_ms", json.int(5000)),
      #("headers", json.object([])),
    ])),
    #("features", json.array([
      json.object([
        #("name", json.string("imported_feature")),
        #("description", json.string("Feature with imported behavior")),
        #("behaviors", json.array([
          json.object([
