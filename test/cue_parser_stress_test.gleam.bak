// Test 4: Invalid CUE (Various Syntax Errors)
fn test_invalid_cue_syntax() {
  // Test missing required fields
  let invalid_data = json.object([
    #("name", json.string("invalid_test")),
    #("description", json.string("Invalid types test")),
    #("audience", json.string("testers")),
    #("version", json.string("1.0.0")),
    #("success_criteria", json.array([json.string("criteria")], json.string)),
    #("config", json.object([
      #("base_url", json.string("http://example.com")),
      #("timeout_ms", json.string("not_a_number")), // Invalid type
      #("headers", json.object([]),
    ])),
    #("features", json.array([json.object([
      #("name", json.string("test")),
      #("description", json.string("test")),
      #("behaviors", json.array([json.object([
        #("name", json.string("test")),
        #("intent", json.string("test")),
        #("notes", json.string("")),
        #("requires", json.array([], json.string)),
        #("tags", json.array([], json.string)),
        #("request", json.object([
          #("method", json.string("INVALID_METHOD")),
          #("path", json.string("/test")),
          #("headers", json.object([])),
          #("query", json.object([])),
          #("body", json.null()),
        ])),
        #("response", json.object([
          #("status", json.int(200)),
          #("example", json.null()),
          #("checks", json.object([]),
        ])),
      ])], json.object))], json.object)),
    #("rules", json.array([], json.object)),
    #("anti_patterns", json.array([], json.object)),
    #("ai_hints", json.object([
      #("implementation", json.object([])),
      #("entities", json.object([])),
      #("security", json.object([
        #("password_hashing", json.string("bcrypt")),
        #("jwt_algorithm", json.string("HS256")),
        #("jwt_expiry", json.string("1h")),
        #("rate_limiting", json.string("100/hour")),
      ])),
      #("pitfalls", json.array([], json.string)),
    ])),
  ])

  let result = parser.parse_spec(invalid_data)
  should.be_error(result)
}

// Test 5: Large CUE Files
fn test_large_spec_file() {
  // Test parser with a large spec file
  let large_data = create_large_spec_file(50) // 50 features

  let result = parser.parse_spec(large_data)
  should.be_ok(result)
}

fn create_large_spec_file(feature_count: Int) -> dynamic.Dynamic {
  let features = list.range(1, feature_count)
  |> list.map(fn(i) {
    json.object([
      #("name", json.string("feature_" <> string.from_int(i))),
      #("description", json.string("Large feature " <> string.from_int(i))),
      #("behaviors", list.range(1, 5)
      |> list.map(fn(j) {
        json.object([
          #("name", json.string("behavior_" <> string.from_int(i) <> "_" <> string.from_int(j))),
          #("intent", json.string("Intent for behavior " <> string.from_int(i) <> "_" <> string.from_int(j))),
          #("notes", json.string("")),
          #("requires", json.array([], json.string)),
          #("tags", json.array([], json.string)),
          #("request", json.object([
            #("method", json.string("GET")),
            #("path", json.string("/test/" <> string.from_int(i) <> "/" <> string.from_int(j))),
            #("headers", json.object([])),
            #("query", json.object([])),
            #("body", json.null()),
          ])),
          #("response", json.object([
            #("status", json.int(200)),
            #("example", json.object([
              #("id", json.string(string.from_int(i))),
              #("result", json.string("success")),
            ])),
            #("checks", json.object([
              #("check_" <> string.from_int(j), json.object([
                #("rule", json.string("$.result == 'success'")),
                #("why", json.string("Check " <> string.from_int(j))),
              ])),
            ])),
          ])),
        ])
      }, json.object)),
    ])
  }, json.array)

  json.object([
    #("name", json.string("large_spec_test")),
    #("description", json.string("Large specification test")),
    #("audience", json.string("testers")),
    #("version", json.string("1.0.0")),
    #("success_criteria", json.array([json.string("Handle large files")], json.string)),
    #("config", json.object([
      #("base_url", json.string("http://example.com")),
      #("timeout_ms", json.int(5000)),
      #("headers", json.object([])),
    ])),
    #("features", features),
    #("rules", json.array([
      json.object([
        #("name", json.string("large_rule")),
        #("description", json.string("Rule for large spec")),
        #("when", json.object([])),
        #("check", json.object([
          #("body_must_contain", json.array([], json.string)),
          #("body_must_not_contain", json.array([], json.string)),
          #("fields_must_exist", json.array([], json.string)),
        ])),
        #("example", json.object([]),
      ]),
    ], json.object)),
    #("anti_patterns", json.array([], json.object)),
    #("ai_hints", json.object([
      #("implementation", json.object([])),
      #("entities", json.object([])),
      #("security", json.object([
        #("password_hashing", json.string("bcrypt")),
        #("jwt_algorithm", json.string("HS256")),
        #("jwt_expiry", json.string("1h")),
        #("rate_limiting", json.string("100/hour")),
      ])),
      #("pitfalls", json.array([], json.string)),
    ])),
  ])
}

// Test 6: CUE Edge Cases and Corner Cases
fn test_unicode_characters() {
  // Test Unicode characters in various fields
  let unicode_data = json.object([
    #("name", json.string("测试名称")),
    #("description", json.string("带有特殊字符的描述: ñáéíóú 中文 русский 日本語")),
    #("audience", json.string("👨‍💻👩‍💻测试人员")),
    #("version", json.string("1.0.0-β")),
    #("success_criteria", json.array([
      json.string("标准1: 基本功能"),
      json.string("标准2: 性能要求"),
    ], json.string)),
    #("config", json.object([
      #("base_url", json.string("http://例子.com")),
      #("timeout_ms", json.int(5000)),
      #("headers", json.object([
        #("X-Content-Language", json.string("zh-CN,en-US")),
        #("X-Emoji", json.string("😀🎉🚀")),
