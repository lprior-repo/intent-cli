          #("body_must_contain", json.array([json.string("你好")], json.string)),
        ])),
        #("example", json.object([
          #("message", json.string("Unicode测试")),
        ])),
      ]),
    ], json.object)),
    #("anti_patterns", json.array([
      json.object([
        #("name", json.string("坏模式")),
        #("description", json.string("Unicode坏例子")),
        #("bad_example", json.object([
          #("error", json.string("乱码: ñáéíóú")),
        ])),
        #("good_example", json.object([
          #("correct", json.string("正确编码: ñáéíóú")),
