            #("notes", json.string("")),
            #("requires", json.array([], json.string)),
            #("tags", json.array([], json.string)),
            #("request", json.object([
              #("method", json.string("GET")),
              #("path", json.string("/import/{{ref:base_url}}/resource")),
              #("headers", json.object([])),
              #("query", json.object([])),
              #("body", json.null()),
            ])),
            #("response", json.object([
