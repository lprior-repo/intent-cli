//// Tests for interview_storage.gleam
//// Covers answer history, session snapshots, diffs, and JSONL persistence

import gleam/dict
import gleam/json
import gleam/list
import gleam/option.{Some}
import gleam/string
import gleeunit/should
import intent/interview.{
  type Answer, type Conflict, type ConflictResolution, type Gap,
  type InterviewSession, type InterviewStage, type Profile, Answer, Cli,
  Complete, Conflict, ConflictResolution, Data, Discovery, Event, Gap,
  InterviewSession, Paused, Refinement, UI, Validation, Workflow, Api,
}
import intent/interview_storage
import intent/interview_storage.{
  type AnswerChangeType, type AnswerDiff, type AnswerVersion, type SessionDiff,
  type SessionSnapshot, Added, Modified, answer_to_version, create_snapshot,
  diff_sessions, format_diff, session_to_json, session_to_jsonl_line,
}
import intent/question_types.{Business, Developer, Ops, Security, User}

// =============================================================================
// Test Helpers & Fixtures
// =============================================================================

fn test_answer(question_id: String, response: String) -> Answer {
  Answer(
    question_id: question_id,
    question_text: "Test question: " <> question_id,
    perspective: Developer,
    round: 1,
    response: response,
    extracted: dict.new(),
    confidence: 0.85,
    notes: "Test note",
    timestamp: "2026-01-11T10:00:00Z",
  )
}

fn test_gap(id: String, resolved: Bool) -> Gap {
  Gap(
    id: id,
    field: "field_" <> id,
    description: "Test gap " <> id,
    blocking: True,
    suggested_default: "default_" <> id,
    why_needed: "For testing",
    round: 1,
    resolved: resolved,
    resolution: case resolved {
      True -> "Resolved by test"
      False -> ""
    },
  )
}

fn test_conflict(id: String, chosen: Int) -> Conflict {
  Conflict(
    id: id,
    between: #("perspective_a", "perspective_b"),
    description: "Test conflict " <> id,
    impact: "Impacts API design",
    options: [
      ConflictResolution(
        option: "Option A",
        description: "Choose A",
        tradeoffs: "Tradeoff A",
        recommendation: "Recommended",
      ),
      ConflictResolution(
        option: "Option B",
        description: "Choose B",
        tradeoffs: "Tradeoff B",
        recommendation: "Alternative",
      ),
    ],
    chosen: chosen,
  )
}

fn test_session(
  id: String,
  answers: List(Answer),
  gaps: List(Gap),
  conflicts: List(Conflict),
) -> InterviewSession {
  InterviewSession(
    id: id,
    profile: Api,
    created_at: "2026-01-11T08:00:00Z",
    updated_at: "2026-01-11T10:00:00Z",
    completed_at: "",
    stage: Discovery,
    rounds_completed: 1,
    answers: answers,
    gaps: gaps,
    conflicts: conflicts,
    raw_notes: "Raw notes for testing",
  )
}

// =============================================================================
// Answer History Tests
// =============================================================================

pub fn answer_to_version_creates_version_with_answer_data_test() {
  let answer = test_answer("q1", "My response")
  let version = answer_to_version(answer, 1, "Initial response")

  version.version
  |> should.equal(1)

  version.response
  |> should.equal("My response")

  version.confidence
  |> should.equal(0.85)

  version.change_reason
  |> should.equal("Initial response")

  version.timestamp
  |> should.equal("2026-01-11T10:00:00Z")
}

pub fn answer_to_version_preserves_extracted_data_test() {
  let extracted = dict.from_list([#("key1", "value1"), #("key2", "value2")])
  let answer =
    Answer(
      question_id: "q1",
      question_text: "Test",
      perspective: User,
      round: 1,
      response: "Response",
      extracted: extracted,
      confidence: 0.9,
      notes: "",
      timestamp: "2026-01-11T10:00:00Z",
    )

  let version = answer_to_version(answer, 1, "Change reason")

  dict.get(version.extracted, "key1")
  |> should.equal(Ok("value1"))

  dict.get(version.extracted, "key2")
  |> should.equal(Ok("value2"))
}

pub fn answer_to_version_tracks_multiple_revisions_test() {
  let answer1 = test_answer("q1", "First response")
  let answer2 =
    Answer(
      ..answer1,
      response: "Updated response",
      timestamp: "2026-01-11T11:00:00Z",
    )

  let v1 = answer_to_version(answer1, 1, "Initial")
  let v2 = answer_to_version(answer2, 2, "Clarification")

  v1.version
  |> should.equal(1)

  v2.version
  |> should.equal(2)

  v1.response
  |> should.equal("First response")

  v2.response
  |> should.equal("Updated response")
}

// =============================================================================
// Session Snapshot Tests
// =============================================================================

pub fn create_snapshot_captures_answers_dict_test() {
  let answers = [
    test_answer("q1", "Answer 1"),
    test_answer("q2", "Answer 2"),
    test_answer("q3", "Answer 3"),
  ]
  let session = test_session("sess1", answers, [], [])

  let snapshot = create_snapshot(session, "Mid-round checkpoint")

  dict.get(snapshot.answers, "q1")
  |> should.equal(Ok("Answer 1"))

  dict.size(snapshot.answers)
  |> should.equal(3)
}

pub fn create_snapshot_includes_session_metadata_test() {
  let session = test_session("sess1", [], [], [])
  let snapshot = create_snapshot(session, "Test checkpoint")

  snapshot.session_id
  |> should.equal("sess1")

  snapshot.snapshot_id
  |> should.equal("sess1-2026-01-11T10:00:00Z")

  snapshot.stage
  |> should.equal("discovery")
}

pub fn create_snapshot_counts_unresolved_gaps_test() {
  let gaps = [
    test_gap("gap1", False),
    test_gap("gap2", True),
    test_gap("gap3", False),
  ]
  let session = test_session("sess1", [], gaps, [])

  let snapshot = create_snapshot(session, "Gap checkpoint")

  snapshot.gaps_count
  |> should.equal(2)
}

pub fn create_snapshot_counts_unresolved_conflicts_test() {
  let conflicts = [
    test_conflict("c1", 0),
    test_conflict("c2", -1),
    test_conflict("c3", 1),
  ]
  let session = test_session("sess1", [], [], conflicts)

  let snapshot = create_snapshot(session, "Conflict checkpoint")

  snapshot.conflicts_count
  |> should.equal(1)
}

pub fn create_snapshot_handles_empty_session_test() {
  let session = test_session("empty1", [], [], [])
  let snapshot = create_snapshot(session, "Empty snapshot")

  dict.size(snapshot.answers)
  |> should.equal(0)

  snapshot.gaps_count
  |> should.equal(0)

  snapshot.conflicts_count
  |> should.equal(0)
}

// =============================================================================
// Session Diff Tests
// =============================================================================

pub fn diff_sessions_detects_added_answers_test() {
  let from = test_session("sess1", [], [], [])
  let to = test_session("sess2", [test_answer("q1", "New answer")], [], [])

  let diff = diff_sessions(from, to)

  list.length(diff.answers_added)
  |> should.equal(1)

  let assert [added] = diff.answers_added
  added.question_id
  |> should.equal("q1")

  added.change_type
  |> should.equal(Added)
}

pub fn diff_sessions_detects_modified_answers_test() {
  let from = test_session("sess1", [test_answer("q1", "Old answer")], [], [])
  let to = test_session("sess2", [test_answer("q1", "New answer")], [], [])

  let diff = diff_sessions(from, to)

  list.length(diff.answers_modified)
  |> should.equal(1)

  let assert [modified] = diff.answers_modified
  modified.change_type
  |> should.equal(Modified)
}

pub fn diff_sessions_detects_removed_answers_test() {
  let from = test_session("sess1", [test_answer("q1", "Answer")], [], [])
  let to = test_session("sess2", [], [], [])

  let diff = diff_sessions(from, to)

  list.length(diff.answers_removed)
  |> should.equal(1)

  diff.answers_removed
  |> should.equal(["q1"])
}

pub fn diff_sessions_ignores_unchanged_answers_test() {
  let answers = [test_answer("q1", "Same")]
  let from = test_session("sess1", answers, [], [])
  let to = test_session("sess2", answers, [], [])

  let diff = diff_sessions(from, to)

  list.length(diff.answers_added)
  |> should.equal(0)

  list.length(diff.answers_modified)
  |> should.equal(0)

  list.length(diff.answers_removed)
  |> should.equal(0)
}

pub fn diff_sessions_detects_gap_additions_test() {
  let from = test_session("sess1", [], [test_gap("gap1", False)], [])
  let to =
    test_session(
      "sess2",
      [],
      [test_gap("gap1", False), test_gap("gap2", False)],
      [],
    )

  let diff = diff_sessions(from, to)

  diff.gaps_added
  |> should.equal(1)
}

pub fn diff_sessions_detects_gap_resolutions_test() {
  let from = test_session("sess1", [], [test_gap("gap1", False)], [])
  let to = test_session("sess2", [], [test_gap("gap1", True)], [])

  let diff = diff_sessions(from, to)

  diff.gaps_resolved
  |> should.equal(1)

  diff.gaps_added
  |> should.equal(0)
}

pub fn diff_sessions_detects_conflict_resolutions_test() {
  let from = test_session("sess1", [], [], [test_conflict("c1", -1)])
  let to = test_session("sess2", [], [], [test_conflict("c1", 0)])

  let diff = diff_sessions(from, to)

  diff.conflicts_resolved
  |> should.equal(1)

  diff.conflicts_added
  |> should.equal(0)
}

pub fn diff_sessions_detects_stage_changes_test() {
  let from = test_session("sess1", [], [], [])
  let to =
    test_session("sess2", [], [], [])
    |> fn(_s) {
      InterviewSession(
        ..test_session("sess2", [], [], []),
        stage: Refinement,
      )
    }

  let diff = diff_sessions(from, to)

  diff.stage_changed
  |> should.equal(Some(#("discovery", "refinement")))
}

pub fn diff_sessions_handles_multiple_changes_test() {
  let from_answers = [test_answer("q1", "Old")]
  let from_gaps = [test_gap("g1", False), test_gap("g2", False)]
  let from = test_session("sess1", from_answers, from_gaps, [])

  let to_answers = [
    test_answer("q1", "New"),
    test_answer("q2", "Fresh"),
  ]
  let to_gaps = [test_gap("g1", True)]
  let to = test_session("sess2", to_answers, to_gaps, [])

  let diff = diff_sessions(from, to)

  list.length(diff.answers_added)
  |> should.equal(1)

  list.length(diff.answers_modified)
  |> should.equal(1)

  diff.gaps_resolved
  |> should.equal(1)
}

// =============================================================================
// Diff Formatting Tests
// =============================================================================

pub fn format_diff_includes_header_test() {
  let from = test_session("sess1", [], [], [])
  let to = test_session("sess2", [], [], [])
  let diff = diff_sessions(from, to)

  let formatted = format_diff(diff)

  string.contains(formatted, "Session Diff: sess1 → sess2")
  |> should.be_true()

  string.contains(formatted, "Time:")
  |> should.be_true()
}

pub fn format_diff_shows_added_answers_test() {
  let from = test_session("sess1", [], [], [])
  let to = test_session("sess2", [test_answer("q1", "Long response text that should be truncated")], [], [])

  let diff = diff_sessions(from, to)
  let formatted = format_diff(diff)

  string.contains(formatted, "Answers Added")
  |> should.be_true()

  string.contains(formatted, "[q1]")
  |> should.be_true()
}

pub fn format_diff_shows_modified_answers_test() {
  let from = test_session("sess1", [test_answer("q1", "Old answer")], [], [])
  let to = test_session("sess2", [test_answer("q1", "New answer")], [], [])

  let diff = diff_sessions(from, to)
  let formatted = format_diff(diff)

  string.contains(formatted, "Answers Modified")
  |> should.be_true()

  string.contains(formatted, "[q1]")
  |> should.be_true()
}

pub fn format_diff_shows_removed_answers_test() {
  let from = test_session("sess1", [test_answer("q1", "Removed")], [], [])
  let to = test_session("sess2", [], [], [])

  let diff = diff_sessions(from, to)
  let formatted = format_diff(diff)

  string.contains(formatted, "Answers Removed")
  |> should.be_true()

  string.contains(formatted, "[q1]")
  |> should.be_true()
}

pub fn format_diff_shows_gap_changes_test() {
  let from = test_session("sess1", [], [test_gap("g1", False), test_gap("g2", False)], [])
  let to = test_session("sess2", [], [test_gap("g1", True)], [])

  let diff = diff_sessions(from, to)
  let formatted = format_diff(diff)

  string.contains(formatted, "Gaps")
  |> should.be_true()
}

pub fn format_diff_shows_conflict_changes_test() {
  let from = test_session("sess1", [], [], [test_conflict("c1", -1), test_conflict("c2", -1)])
  let to = test_session("sess2", [], [], [test_conflict("c1", 0)])

  let diff = diff_sessions(from, to)
  let formatted = format_diff(diff)

  string.contains(formatted, "Conflicts")
  |> should.be_true()
}

pub fn format_diff_handles_no_changes_test() {
  let session = test_session("sess1", [], [], [])
  let diff = diff_sessions(session, session)
  let formatted = format_diff(diff)

  string.contains(formatted, "Session Diff")
  |> should.be_true()
}

// =============================================================================
// JSON Encoding Tests
// =============================================================================

pub fn session_to_jsonl_line_produces_valid_json_test() {
  let session = test_session("sess1", [test_answer("q1", "answer1")], [], [])

  let jsonl_line = session_to_jsonl_line(session)

  // Should be valid JSON (non-empty string)
  string.length(jsonl_line) > 0
  |> should.be_true()
}

pub fn session_to_jsonl_includes_all_fields_test() {
  let session = test_session("sess1", [test_answer("q1", "answer1")], [], [])
  let json_obj = session_to_json(session)
  let json_str = json.to_string(json_obj)

  string.contains(json_str, "\"id\"")
  |> should.be_true()

  string.contains(json_str, "sess1")
  |> should.be_true()

  string.contains(json_str, "\"profile\"")
  |> should.be_true()
}

pub fn snapshot_serialization_preserves_data_test() {
  let answers = [
    test_answer("q1", "Response 1"),
    test_answer("q2", "Response 2"),
  ]
  let session = test_session("sess1", answers, [], [])
  let snapshot = create_snapshot(session, "Checkpoint")

  dict.size(snapshot.answers)
  |> should.equal(2)

  dict.get(snapshot.answers, "q1")
  |> should.equal(Ok("Response 1"))
}

