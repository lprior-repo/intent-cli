//// Tests for interview_questions module
//// Covers question loading, filtering, and fallback behavior

import gleam/int
import gleam/list
import gleam/option.{None, Some}
import gleam/string
import gleeunit/should
import intent/interview_questions
import intent/question_loader
import intent/question_types.{
  type Question, Business, Critical, Developer, EdgeCase, ErrorCase, HappyPath,
  Important, NiceTohave, NonFunctional, Ops, Security, User,
}

/// Helper to create a test question
fn test_question(id: String, round: Int, profile: String) -> Question {
  Question(
    id: id,
    round: round,
    perspective: User,
    category: HappyPath,
    priority: Critical,
    question: "Test question for " <> profile <> " round " <> int.to_string(round),
    context: "Test context",
    example: "Test example",
    expected_type: "text",
    extract_into: [],
    depends_on: [],
    blocks: [],
  )
}

/// Happy path: get_questions_for_round returns list when fallback succeeds
pub fn get_questions_for_round_returns_fallback_on_load_error_test() {
  let questions = interview_questions.get_questions_for_round("api", 1)
  questions
  |> list.length
  |> should.be_greater_than_or_equal(1)
}

/// Happy path: get_next_question with empty answered list returns first question
pub fn get_next_question_returns_first_when_none_answered_test() {
  let result = interview_questions.get_next_question("api", 1, [])
  case result {
    Some(q) -> q.id |> should.not_equal("")
    None -> should.fail()
  }
}

/// Happy path: get_next_question with all answered returns None
pub fn get_next_question_returns_none_when_all_answered_test() {
  let questions = interview_questions.get_questions_for_round("api", 1)
  let answered_ids = questions |> list.map(fn(q) { q.id })
  let result = interview_questions.get_next_question("api", 1, answered_ids)
  result |> should.equal(None)
}

/// Happy path: get_next_question skips answered questions and returns next
pub fn get_next_question_returns_next_unanswered_test() {
  let questions = interview_questions.get_questions_for_round("api", 1)
  case questions {
    [] -> should.fail()
    [_] -> should.fail()
    [first, second, ..] -> {
      let answered_ids = [first.id]
      let result = interview_questions.get_next_question("api", 1, answered_ids)
      case result {
        Some(q) -> q.id |> should.equal(second.id)
        None -> should.fail()
      }
    }
  }
}

/// Edge case: get_questions_for_round with unknown profile returns empty
pub fn get_questions_for_round_with_unknown_profile_test() {
  let questions = interview_questions.get_questions_for_round("unknown_profile", 1)
  questions |> list.length |> should.equal(0)
}

/// Edge case: get_questions_for_round with invalid round returns empty
pub fn get_questions_for_round_with_invalid_round_test() {
  let questions = interview_questions.get_questions_for_round("api", 999)
  questions |> list.length |> should.equal(0)
}

/// Edge case: get_next_question with empty questions list
pub fn get_next_question_with_no_questions_returns_none_test() {
  let result = interview_questions.get_next_question("unknown", 999, [])
  result |> should.equal(None)
}

/// Edge case: get_questions_for_round_with_db with valid profile and round
pub fn get_questions_for_round_with_db_valid_profile_test() {
  let api_questions = question_loader.ProfileQuestions(
    round_1: [test_question("api-1", 1, "api"), test_question("api-2", 1, "api")],
    round_2: [test_question("api-3", 2, "api")],
  )

  let cli_questions = question_loader.ProfileQuestions(
    round_1: [test_question("cli-1", 1, "cli")],
    round_2: [test_question("cli-2", 2, "cli")],
  )

  let event_questions = question_loader.ProfileQuestions(
    round_1: [test_question("event-1", 1, "event")],
    round_2: [test_question("event-2", 2, "event")],
  )

  let data_questions = question_loader.ProfileQuestions(
    round_1: [test_question("data-1", 1, "data")],
    round_2: [test_question("data-2", 2, "data")],
  )

  let workflow_questions = question_loader.ProfileQuestions(
    round_1: [test_question("workflow-1", 1, "workflow")],
    round_2: [test_question("workflow-2", 2, "workflow")],
  )

  let ui_questions = question_loader.ProfileQuestions(
    round_1: [test_question("ui-1", 1, "ui")],
    round_2: [test_question("ui-2", 2, "ui")],
  )

  let common_questions = question_loader.CommonQuestions(
    round_3: [test_question("common-3", 3, "common")],
    round_4: [test_question("common-4", 4, "common")],
    round_5: [test_question("common-5", 5, "common")],
  )

  let db = question_loader.QuestionsDatabase(
    api: api_questions,
    cli: cli_questions,
    event: event_questions,
    data: data_questions,
    workflow: workflow_questions,
    ui: ui_questions,
    common: common_questions,
  )

  let questions = interview_questions.get_questions_for_round_with_db("api", 1, db)
  questions |> list.length |> should.equal(2)

  case questions {
    [first, second] -> {
      first.id |> should.equal("api-1")
      second.id |> should.equal("api-2")
    }
    _ -> should.fail()
  }
}

/// Edge case: get_questions_for_round_with_db retrieves round 2
pub fn get_questions_for_round_with_db_round_two_test() {
  let api_questions = question_loader.ProfileQuestions(
    round_1: [test_question("api-1", 1, "api")],
    round_2: [test_question("api-2", 2, "api"), test_question("api-3", 2, "api")],
  )

  let cli_questions = question_loader.ProfileQuestions(round_1: [], round_2: [])
  let event_questions = question_loader.ProfileQuestions(round_1: [], round_2: [])
  let data_questions = question_loader.ProfileQuestions(round_1: [], round_2: [])
  let workflow_questions = question_loader.ProfileQuestions(round_1: [], round_2: [])
  let ui_questions = question_loader.ProfileQuestions(round_1: [], round_2: [])
  let common_questions = question_loader.CommonQuestions(round_3: [], round_4: [], round_5: [])

  let db = question_loader.QuestionsDatabase(
    api: api_questions,
    cli: cli_questions,
    event: event_questions,
    data: data_questions,
    workflow: workflow_questions,
    ui: ui_questions,
    common: common_questions,
  )

  let questions = interview_questions.get_questions_for_round_with_db("api", 2, db)
  questions |> list.length |> should.equal(2)
}

/// Edge case: get_questions_for_round_with_db for common round 3
pub fn get_questions_for_round_with_db_common_round_three_test() {
  let profile_empty = question_loader.ProfileQuestions(round_1: [], round_2: [])

  let common_questions = question_loader.CommonQuestions(
    round_3: [test_question("common-3-1", 3, "common"), test_question("common-3-2", 3, "common")],
    round_4: [],
    round_5: [],
  )

  let db = question_loader.QuestionsDatabase(
    api: profile_empty,
    cli: profile_empty,
    event: profile_empty,
    data: profile_empty,
    workflow: profile_empty,
    ui: profile_empty,
    common: common_questions,
  )

  let questions = interview_questions.get_questions_for_round_with_db("anyprofile", 3, db)
  questions |> list.length |> should.equal(2)
}

/// Error case: get_questions_for_round returns fallback on load error
pub fn get_questions_for_round_fallback_for_round_one_test() {
  let questions = interview_questions.get_questions_for_round("api", 1)

  case questions {
    [q] -> {
      q.id |> should.equal("fallback-1")
      q.round |> should.equal(1)
      q.perspective |> should.equal(User)
      q.category |> should.equal(HappyPath)
      q.priority |> should.equal(Critical)
    }
    _ -> should.fail()
  }
}

/// Error case: get_questions_for_round returns empty list for non-round-1
pub fn get_questions_for_round_fallback_for_other_rounds_empty_test() {
  let questions = interview_questions.get_questions_for_round("api", 2)
  questions |> list.length |> should.equal(0)
}

/// Boundary: get_next_question with single question and multiple answered IDs
pub fn get_next_question_with_multiple_answered_ids_test() {
  let questions = interview_questions.get_questions_for_round("api", 1)

  case questions {
    [q, ..] -> {
      let answered_ids = [q.id, "non-existent-1", "non-existent-2"]
      let result = interview_questions.get_next_question("api", 1, answered_ids)
      result |> should.equal(None)
    }
    [] -> should.fail()
  }
}

/// Boundary: get_next_question with partial answered list
pub fn get_next_question_returns_correct_unanswered_test() {
  let questions = interview_questions.get_questions_for_round("api", 1)

  case questions {
    [first, second, third, ..] -> {
      let answered_ids = [first.id, second.id]
      let result = interview_questions.get_next_question("api", 1, answered_ids)
      case result {
        Some(q) -> q.id |> should.equal(third.id)
        None -> should.fail()
      }
    }
    _ -> True |> should.be_true
  }
}

/// Property: All profiles return consistent results
pub fn all_profiles_return_fallback_on_load_error_test() {
  let profiles = ["api", "cli", "event", "data", "workflow", "ui"]

  profiles
  |> list.all(fn(profile) {
    let questions = interview_questions.get_questions_for_round(profile, 1)
    list.length(questions) >= 0
  })
  |> should.be_true
}

/// Boundary: Profile name matching is case-sensitive
pub fn get_questions_case_sensitive_profile_test() {
  let lower_case = interview_questions.get_questions_for_round("api", 1)
  let upper_case = interview_questions.get_questions_for_round("API", 1)

  lower_case
  |> list.length
  |> should.not_equal(upper_case |> list.length)
}

/// Boundary: Round 0 returns empty
pub fn get_questions_with_round_zero_returns_empty_test() {
  let questions = interview_questions.get_questions_for_round("api", 0)
  questions |> list.length |> should.equal(0)
}

/// Boundary: Very large round number returns empty
pub fn get_questions_with_large_round_returns_empty_test() {
  let questions = interview_questions.get_questions_for_round("api", 1_000_000)
  questions |> list.length |> should.equal(0)
}

/// Consistency: Multiple calls return same results
pub fn get_questions_for_round_is_deterministic_test() {
  let first_call = interview_questions.get_questions_for_round("api", 1)
  let second_call = interview_questions.get_questions_for_round("api", 1)

  first_call |> list.length |> should.equal(second_call |> list.length)
}

/// Consistency: get_next_question is deterministic
pub fn get_next_question_is_deterministic_test() {
  let answered = ["fallback-1"]

  let first_call = interview_questions.get_next_question("api", 1, answered)
  let second_call = interview_questions.get_next_question("api", 1, answered)

  first_call |> should.equal(second_call)
}

/// Spec: Fallback question has profile name in text
pub fn fallback_question_includes_profile_name_test() {
  let questions = interview_questions.get_questions_for_round("my_profile", 1)

  case questions {
    [q] -> {
      let has_profile = string.contains(q.question, "my_profile")
      has_profile |> should.be_true
    }
    _ -> True |> should.be_true
  }
}

/// Spec: Fallback question has correct context
pub fn fallback_question_has_correct_context_test() {
  let questions = interview_questions.get_questions_for_round("api", 1)

  case questions {
    [q] -> {
      let has_fallback = string.contains(q.context, "fallback")
      has_fallback |> should.be_true
    }
    _ -> True |> should.be_true
  }
}

/// Spec: Fallback question extracts name
pub fn fallback_question_extracts_name_test() {
  let questions = interview_questions.get_questions_for_round("api", 1)

  case questions {
    [q] -> {
      q.extract_into |> list.contains("name") |> should.be_true
    }
    _ -> True |> should.be_true
  }
}

/// Integration: Questions and next work together
pub fn get_questions_and_next_work_together_test() {
  let profile_questions = question_loader.ProfileQuestions(
    round_1: [
      test_question("q1", 1, "test"),
      test_question("q2", 1, "test"),
      test_question("q3", 1, "test"),
    ],
    round_2: [],
  )

  let common_questions = question_loader.CommonQuestions(
    round_3: [],
    round_4: [],
    round_5: [],
  )

  let db = question_loader.QuestionsDatabase(
    api: profile_questions,
    cli: question_loader.ProfileQuestions(round_1: [], round_2: []),
    event: question_loader.ProfileQuestions(round_1: [], round_2: []),
    data: question_loader.ProfileQuestions(round_1: [], round_2: []),
    workflow: question_loader.ProfileQuestions(round_1: [], round_2: []),
    ui: question_loader.ProfileQuestions(round_1: [], round_2: []),
    common: common_questions,
  )

  let questions = interview_questions.get_questions_for_round_with_db("api", 1, db)
  questions |> list.length |> should.equal(3)

  let result1 = interview_questions.get_next_question("api", 1, [])
  case result1 {
    Some(q) -> q.id |> should.equal("q1")
    None -> should.fail()
  }

  let result2 = interview_questions.get_next_question("api", 1, ["q1"])
  case result2 {
    Some(q) -> q.id |> should.equal("q2")
    None -> should.fail()
  }

  let result3 = interview_questions.get_next_question("api", 1, ["q1", "q2"])
  case result3 {
    Some(q) -> q.id |> should.equal("q3")
    None -> should.fail()
  }

  let result4 = interview_questions.get_next_question("api", 1, ["q1", "q2", "q3"])
  result4 |> should.equal(None)
}
