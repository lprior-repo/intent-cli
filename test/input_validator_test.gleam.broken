import gleam/dynamic
import gleam/json
import gleeunit
import gleeunit/should
import intent/input_validator

pub fn main() {
  gleeunit.main()
}

// ============================================================================
// Mock Command Executor for Testing
// ============================================================================

/// Mock executor that succeeds (cue vet passes)
fn mock_executor_success(
  _cmd: String,
  _args: List(String),
  _dir: String,
) -> Result(String, #(Int, String)) {
  Ok("")
}

/// Mock executor that fails with validation error
fn mock_executor_validation_error(
  _cmd: String,
  _args: List(String),
  _dir: String,
) -> Result(String, #(Int, String)) {
  Error(#(
    1,
    "validation error:\nfield 'name' is required\nfield 'age' must be >= 0",
  ))
}

/// Mock executor that fails with schema not found
fn mock_executor_schema_not_found(
  _cmd: String,
  _args: List(String),
  _dir: String,
) -> Result(String, #(Int, String)) {
  Error(#(1, "cannot find package: schema not found"))
}

// ============================================================================
// Pure Function Tests - parse_cue_vet_result
// ============================================================================

pub fn parse_cue_vet_result_success_test() {
  let result = Ok("")
  let parsed = input_validator.parse_cue_vet_result(result)
  parsed |> should.be_ok
}

pub fn parse_cue_vet_result_validation_error_test() {
  let result = Error(#(1, "validation error: field required"))
  let parsed = input_validator.parse_cue_vet_result(result)

  case parsed {
    Error(input_validator.ValidationFailed(exit_code, stderr)) -> {
      exit_code |> should.equal(1)
      stderr |> should.equal("validation error: field required")
    }
    _ -> {
      False |> should.be_true
    }
  }
}

// ============================================================================
// Pure Function Tests - dynamic_to_json_string
// ============================================================================

pub fn dynamic_to_json_string_valid_test() {
  let data =
    [#("name", json.string("Alice")), #("age", json.int(30))]
    |> json.object
    |> json.to_string
    |> json.decode(dynamic.dynamic)

  case data {
    Ok(dynamic_data) -> {
      let result = input_validator.dynamic_to_json_string(dynamic_data)
      result |> should.be_ok
    }
    Error(_) -> {
      False |> should.be_true
    }
  }
}

// ============================================================================
// Integration Tests - validate_request_body_with_executor
// ============================================================================

pub fn validate_valid_request_body_test() {
  let body =
    [#("name", json.string("Alice")), #("age", json.int(30))]
    |> json.object
    |> json.to_string
    |> json.decode(dynamic.dynamic)

  case body {
    Ok(dynamic_body) -> {
      let result =
        input_validator.validate_request_body_with_executor(
          dynamic_body,
          "schema/test-schema.cue",
          mock_executor_success,
        )
      result |> should.be_ok
    }
    Error(_) -> {
      False |> should.be_true
    }
  }
}

pub fn validate_invalid_request_body_test() {
  let body =
    [#("invalid", json.string("data"))]
    |> json.object
    |> json.to_string
    |> json.decode(dynamic.dynamic)

  case body {
    Ok(dynamic_body) -> {
      let result =
        input_validator.validate_request_body_with_executor(
          dynamic_body,
          "schema/test-schema.cue",
          mock_executor_validation_error,
        )

      case result {
        Error(input_validator.ValidationFailed(_, stderr)) -> {
          stderr
          |> should.equal(
            "validation error:\nfield 'name' is required\nfield 'age' must be >= 0",
          )
        }
        _ -> {
          False |> should.be_true
        }
      }
    }
    Error(_) -> {
      False |> should.be_true
    }
  }
}

pub fn validate_missing_schema_test() {
  let body =
    [#("name", json.string("Alice"))]
    |> json.object
    |> json.to_string
    |> json.decode(dynamic.dynamic)

  case body {
    Ok(dynamic_body) -> {
      let result =
        input_validator.validate_request_body_with_executor(
          dynamic_body,
          "schema/nonexistent.cue",
          mock_executor_schema_not_found,
        )

      case result {
        Error(input_validator.ValidationFailed(_, stderr)) -> {
          stderr |> should.equal("cannot find package: schema not found")
        }
        _ -> {
          False |> should.be_true
        }
      }
    }
    Error(_) -> {
      False |> should.be_true
    }
  }
}

// ============================================================================
// Error Formatting Tests
// ============================================================================

pub fn format_validation_error_test() {
  let error = input_validator.ValidationFailed(1, "field required")
  let formatted = input_validator.format_validation_error(error)
  formatted |> should.equal("Validation failed (exit code 1):\nfield required")
}

pub fn format_security_error_test() {
  let error = input_validator.SecurityError("Invalid path")
  let formatted = input_validator.format_validation_error(error)
  formatted |> should.equal("Invalid path")
}
