  "commands_to_implement": {
    "vision start": {
      "purpose": "Start new vision command session",
      "inputs": "spec_path (arg), profile (flag, default='api')",
      "outputs": "session_id, status='in_progress', created_at, next_actions",
      "exit_codes": "0=success, 4=missing_spec_path",
      "imports_needed": ["gleam/json", "glint", "glint/flag", "intent/ffi", "intent/json_output"],
      "reference": "ready_commands.ready_start_command() line 36"
    },
    "vision check": {
      "purpose": "Check vision command session status",
      "inputs": "session (flag, required)",
      "outputs": "session_id, status, critique_score, responses_count, updated_at",
      "exit_codes": "0=success, 4=missing_session",
      "imports_needed": ["gleam/json", "glint", "glint/flag", "intent/json_output"],
      "reference": "ready_commands.ready_check_command()"
    },
    "vision critique": {
      "purpose": "Run Skeptical PM critique on vision",
      "inputs": "session (flag, required), spec_path (arg, optional)",
      "outputs": "critique_result, score, issues_count, passed, next_actions",
      "exit_codes": "0=critique_run, 3=critique_failed",
      "imports_needed": ["gleam/json", "gleam/list", "gleam/result", "glint", "glint/flag", "intent/json_output", "intent/vision_critique"],
      "reference": "ready_commands.ready_critique_command()",
      "integration": "Call vision_critique.critique_vision(vision_section)"
    },
    "vision respond": {
      "purpose": "Submit response to critique issue",
      "inputs": "session (flag, required), issue_id (flag, required), response (flag, required)",
      "outputs": "session_id, responses_count, status='ready_for_critique' or 'in_progress'",
      "exit_codes": "0=response_recorded, 4=missing_required_fields",
      "imports_needed": ["gleam/json", "glint", "glint/flag", "intent/ffi", "intent/json_output"],
      "reference": "ready_commands.ready_respond_command()",
      "integration": "Call vision_commands.record_response()"
    },
    "vision agree": {
      "purpose": "Finalize vision session (requires score >= 70)",
      "inputs": "session (flag, required)",
      "outputs": "session_id, status='complete', finalized_at, critique_score",
      "exit_codes": "0=finalized, 3=score_too_low (<70), 4=session_not_complete",
      "imports_needed": ["gleam/json", "glint", "glint/flag", "intent/ffi", "intent/json_output", "intent/vision_commands"],
      "reference": "ready_commands.ready_agree_command()",
      "integration": "Call vision_commands.agree_session(), handle error"
    }
  },
