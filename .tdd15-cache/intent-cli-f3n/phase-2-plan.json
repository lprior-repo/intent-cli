  "implementation_plan": {
    "overview": "Implement 4 vision commands using Glint CLI pattern, following existing interview command structure",
    "new_modules": [
      {
        "file": "src/intent/vision_session.gleam",
        "purpose": "Vision session state management with pure functions",
        "exports": [
          "VisionSession type",
          "VisionAnswer type",
          "VisionGap type",
          "VisionConflict type",
          "VisionStatus type (InProgress, ReadyForCritique, Complete)",
          "create_session(id, profile, created_at) -> VisionSession",
          "record_answer(session, question_id, answer, extracted) -> VisionSession",
          "build_vision_section(session) -> Result(VisionSection, String)",
          "find_answer(session, question_id) -> Option(VisionAnswer)",
          "get_answered_count(session) -> Int",
          "get_required_unanswered(session, questions) -> List(Question)"
        ],
        "dependencies": ["vision_types", "dict", "list", "option"]
      },
      {
        "file": "src/intent/vision_session_storage.gleam",
        "purpose": "JSONL persistence for vision sessions",
        "pattern": "Functional Core / Imperative Shell with dependency injection",
        "exports": [
          "FileReader, FileWriter, DirectoryCreator types",
          "session_to_json(session) -> Json",
          "session_from_json(data) -> Result(VisionSession, DecodeErrors)",
          "save_session(session, path) -> Result(Nil, String)",
          "load_session(session_id, path) -> Result(VisionSession, String)",
          "list_sessions(path) -> Result(List(VisionSession), String)",
          "simplifile_reader(), simplifile_writer(), simplifile_dir_creator()"
        ],
        "default_path": ".intent/vision-sessions.jsonl",
        "dependencies": ["vision_session", "json", "dynamic", "simplifile", "result"]
      }
    ],
    "command_implementations": [
      {
        "command": "vision start",
        "glint_path": ["vision", "start"],
        "flags": ["--profile (string, default='api')"],
        "logic": [
          "1. Parse --profile flag",
          "2. Load questions: question_loader.load_default_questions()",
          "3. Get vision questions: question_loader.get_questions(db, profile, 1)",
          "4. Generate session ID: ffi.generate_uuid()",
          "5. Get timestamp: ffi.get_timestamp()",
          "6. Create session: vision_session.create_session(id, profile, timestamp)",
          "7. Save session: vision_session_storage.save_session(session, path)",
          "8. Build questions JSON array",
          "9. Return json_output.success with session_id, questions, created_at"
        ],
        "output_action": "vision_start_result",
        "next_actions": ["intent vision answer --session-id={id} --question-id={first_q} --answer='...'"],
        "error_cases": [
          "Invalid profile: return error 'Unknown profile'",
          "Questions load fail: return error 'Failed to load questions'",
          "Session save fail: return error 'Failed to save session'"
        ]
      },
      {
        "command": "vision answer",
        "glint_path": ["vision", "answer"],
        "flags": [
          "--session-id (string, required)",
          "--question-id (string, required)",
          "--answer (string, required)"
        ],
        "logic": [
          "1. Parse flags: session-id, question-id, answer",
          "2. Validate all flags present",
          "3. Load session: vision_session_storage.load_session(session_id, path)",
          "4. Load questions database",
          "5. Find question by ID",
          "6. Extract fields from answer (using question.extract_into)",
          "7. Build extracted: Dict(String, String)",
          "8. Check for conflicts (placeholder: return empty list)",
          "9. Record answer: vision_session.record_answer(session, qid, answer, extracted)",
          "10. Save updated session",
          "11. Count remaining questions",
          "12. Return json_output.success with answered, extracted, conflicts, remaining"
        ],
        "output_action": "vision_answer_result",
        "next_actions": [
          "If more questions: intent vision answer --session-id={id} --question-id={next_q}",
          "If all answered: intent vision critique --session-id={id}"
        ],
        "error_cases": [
          "Session not found: return error 'Session {id} not found'",
          "Question not found: return error 'Question {id} not found'",
          "Missing flags: return error 'Required flag missing'"
        ]
      },
      {
        "command": "vision critique",
        "glint_path": ["vision", "critique"],
        "flags": ["--session-id (string, required)"],
        "logic": [
          "1. Parse --session-id flag",
          "2. Load session",
          "3. Build VisionSection: vision_session.build_vision_section(session)",
          "4. Run critique: vision_critique.critique_vision(section)",
          "5. Extract CritiqueResult fields",
          "6. Map issues to JSON array",
          "7. Return json_output.success with persona, issues, score, passed"
        ],
        "output_action": "vision_critique_result",
        "next_actions": [
          "If passed: intent vision check --session-id={id}",
          "If not passed: Fix critical issues by answering questions again"
        ],
        "error_cases": [
          "Session not found: return error",
          "Incomplete answers: return error 'Missing required answers for critique'"
        ]
      },
      {
        "command": "vision check",
        "glint_path": ["vision", "check"],
        "flags": ["--session-id (string, required)"],
        "logic": [
          "1. Parse --session-id flag",
          "2. Load session",
          "3. Build VisionSection",
          "4. Run critique: vision_critique.critique_vision(section)",
          "5. Determine gate_status: score >= 70 && passed ? 'unlocked' : 'locked'",
          "6. Extract blockers: filter Critical issues",
          "7. Return json_output.success with gate_status, score, blockers, can_proceed"
        ],
        "output_action": "vision_check_result",
        "next_actions": [
          "If unlocked: intent shape start",
          "If locked: Fix blockers with intent vision answer"
        ],
        "error_cases": ["Session not found: return error"]
      }
    ],
