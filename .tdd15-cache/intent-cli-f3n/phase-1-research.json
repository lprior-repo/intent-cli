    "data_flow": {
      "vision_start": [
        "1. Parse --profile flag",
        "2. Load vision questions from question_loader (profile='vision', round=1)",
        "3. Create new VisionSession with UUID",
        "4. Save session to JSONL",
        "5. Return session_id + questions list"
      ],
      "vision_answer": [
        "1. Parse --session-id, --question-id, --answer flags",
        "2. Load VisionSession from JSONL",
        "3. Extract fields from answer (based on question.extract_into)",
        "4. Check for conflicts with previous answers",
        "5. Record VisionAnswer in session",
        "6. Save updated session to JSONL",
        "7. Return answered=true, extracted fields, conflicts, remaining questions count"
      ],
      "vision_critique": [
        "1. Parse --session-id flag",
        "2. Load VisionSession from JSONL",
        "3. Build VisionSection from answered questions",
        "4. Call vision_critique.critique_vision(section)",
        "5. Return CritiqueResult (issues, score, passed)"
      ],
      "vision_check": [
        "1. Parse --session-id flag",
        "2. Run critique (same as vision_critique)",
        "3. Check if score >= 70 (pass threshold)",
        "4. Return gate_status: 'unlocked' or 'locked', blockers list"
      ]
    },
